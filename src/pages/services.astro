---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import type { Service } from '../types';
import servicesData from '../data/services.json';

const services = servicesData as Service[];

const icons: Record<string, string> = {
  bolt: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M13 3l-4 9h6l-4 9" />`,
  'cloud-storm': `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 18a4.6 4.4 0 0 1 0 -9a5 4.5 0 0 1 11 2h1a3.5 3.5 0 0 1 0 7" /><path d="M13 14l-2 4l3 0l-2 4" />`,
  camera: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" /><circle cx="12" cy="13" r="3" />`,
  'shield-lock': `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
  plug: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9.785 6l-3.785 3.785a2 2 0 0 0 0 2.829l4.586 4.586a2 2 0 0 0 2.829 0l3.785 -3.785" /><path d="M10 15l-5 5" /><path d="M15 10l5 -5" /><path d="M7 7l1 1" /><path d="M16 16l1 1" />`,
  tool: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5"/>`,
};

const steps = [
  {
    title: 'Consultation',
    description: 'We discuss your requirements, site conditions, and project timeline.',
  },
  {
    title: 'Site Assessment',
    description: 'Our engineers conduct a site survey and prepare technical drawings.',
  },
  {
    title: 'URA Approval',
    description: 'Drawings and plans are submitted to URA for regulatory approval.',
  },
  {
    title: 'Installation',
    description: 'Our certified team carries out the installation to specification.',
  },
  {
    title: 'Testing & Handover',
    description: 'Full system testing, commissioning, and documentation handover.',
  },
];
---

<BaseLayout
  title="Services"
  description="End-to-end electrical engineering services from Multitec Maldives — panel boards, lightning protection, CCTV, access control, wiring, and maintenance across the Maldives."
>

  <!-- ── SECTION 1: PAGE HERO ── -->
  <PageHero
    title="Our Services"
    subtitle="End-to-end electrical engineering solutions for residential, commercial, and resort projects across the Maldives"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  />

  <!-- ── SECTION 2: SERVICES GRID ── -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          What We Offer
        </p>
        <h2 id="services-heading" class="text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Electrical Engineering Solutions
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          Every service we offer is backed by qualified engineers, URA-compliant documentation,
          and 23 years of experience in the Maldives.
        </p>
      </header>

      <div class="grid gap-8 md:grid-cols-2">
        {services.map((service) => (
          <article
            id={service.id}
            class="flex flex-col gap-6 rounded-2xl border border-base-200 bg-white p-8 shadow-sm"
            data-animate
          >
            <!-- Icon -->
            <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-[#E31E24] text-white shadow-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[service.icon] ?? icons.bolt}
              />
            </div>

            <!-- Content -->
            <div class="flex flex-1 flex-col gap-3">
              <h2 class="text-xl font-bold text-[#1a1a1a]">{service.title}</h2>
              <p class="text-sm font-medium text-[#4a4a4a]">{service.shortDescription}</p>
              {service.fullDescription && (
                <p class="text-sm leading-relaxed text-[#4a4a4a]/80">{service.fullDescription}</p>
              )}
            </div>

            <!-- CTA -->
            <div class="pt-2">
              <a
                href="/contact"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#E31E24] hover:underline"
              >
                Request a Quote
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SECTION 3: HOW WE WORK ── -->
  <section class="bg-[#F5F5F5] py-20 md:py-28" aria-labelledby="process-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-16 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          Our Process
        </p>
        <h2 id="process-heading" class="text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          How We Work
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          A straightforward process from first contact to project handover.
        </p>
      </header>

      <!-- Steps -->
      <div class="relative">
        <!-- Connector line — desktop only, sits behind the step circles -->
        <div
          class="absolute top-6 left-8 right-8 hidden h-px bg-[#1a1a1a]/10 md:block"
          aria-hidden="true"
        ></div>

        <ol class="relative grid grid-cols-1 gap-8 md:grid-cols-5 md:gap-4">
          {steps.map((step, i) => (
            <li
              class="flex flex-row items-start gap-4 md:flex-col md:items-center md:text-center"
              data-animate
            >
              <!-- Step number circle -->
              <div class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#E31E24] text-sm font-bold text-white ring-4 ring-[#F5F5F5]">
                {i + 1}
              </div>
              <!-- Step content -->
              <div class="flex-1 md:flex-none">
                <h3 class="text-sm font-semibold text-[#1a1a1a]">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-[#4a4a4a]">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ── SECTION 4: CTA BANNER ── -->
  <CtaBanner
    heading="Have a Project in Mind?"
    subtext="Tell us about your requirements and we'll put together a tailored solution for you."
    buttonText="Request a Quote"
    buttonLink="/contact"
  />

</BaseLayout>
