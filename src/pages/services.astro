---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getServices } from '../utils/sanity';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { SERVICE_REFERENCES } from '../data/service-references';

const services = await getServices();
---

<BaseLayout
  title="Services"
  description="End-to-end electrical engineering services from Multitec Maldives — panel boards, lightning protection, CCTV, access control, wiring, and maintenance across the Maldives."
>

  <!-- ── SECTION 1: PAGE HERO ── -->
  <PageHero
    title="Our Services"
    subtitle="End-to-end electrical engineering solutions for residential, commercial, and resort projects across the Maldives"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  />

  <!-- ── SECTION 2: SERVICES ── -->
  <section class="bg-white section-y" aria-labelledby="services-heading">
    <div class="column">
      <SectionHeading
        id="services-heading"
        title="Electrical engineering, end to end."
        intro="Every service is backed by qualified engineers, URA-compliant documentation and 23 years of experience in the Maldives."
      />

      <!-- One row per service: name and standard on the left, detail on the right. -->
      <div class="border-t-[1.5px] border-[#1a1a1a]">
        {services.map((service) => (
          <article id={service.id} class="grid scroll-mt-24 gap-x-12 gap-y-4 border-b border-[#d3d7da] py-10 md:grid-cols-[5fr_7fr]" data-animate>
            <div>
              <h3 class="font-display text-[clamp(1.6rem,2.6vw,2.2rem)] font-bold leading-[1.08] tracking-[-0.02em] text-[#1a1a1a]">{service.title}</h3>
              {SERVICE_REFERENCES[service.id] && (
                <p class="mt-3 text-sm font-semibold text-[#E31E24]">{SERVICE_REFERENCES[service.id]}</p>
              )}
            </div>
            <div class="grid content-start gap-4">
              <p class="text-lg leading-relaxed text-[#1a1a1a]">{service.shortDescription}</p>
              {service.fullDescription && <p class="leading-relaxed">{service.fullDescription}</p>}
              <a href={`/contact?type=quote&service=${service.id}`} class="link-underline w-fit text-[#1a1a1a]">
                Request a quote<span class="sr-only"> for {service.title}</span>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SECTION 3: HOW WE WORK ── -->
  <section class="bg-[#f5f6f6] section-y" aria-labelledby="process-heading">
    <div class="column">
      <SectionHeading
        id="process-heading"
        title="How we work."
        intro="A straightforward process from first contact to project handover."
      />
      <ProcessSteps />
    </div>
  </section>

  <!-- ── SECTION 4: CTA BANNER ── -->
  <CtaBanner
    heading="Have a project in mind?"
    subtext="Tell us about your requirements and we'll put together a tailored solution for you."
    buttonText="Request a Quote"
    buttonLink="/contact?type=quote"
  />

</BaseLayout>
