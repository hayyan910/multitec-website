---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<BaseLayout
  title="Services"
  description="Multitec Maldives offers a full range of electrical engineering services: installations, power systems design, solar PV, testing, commissioning, and planned maintenance."
>
  <section class="flex min-h-[70vh] items-center justify-center px-4">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-[#1a1a1a] md:text-5xl">Our Services</h1>
      <p class="mt-6 text-lg text-[#4a4a4a]">Services page — full design coming soon.</p>
    </div>
  </section>

  <CtaBanner
    heading="Need a Quotation?"
    subtext="Send us your project details and we'll respond within one business day."
    buttonText="Contact Us"
    buttonLink="/contact"
  />
</BaseLayout>
