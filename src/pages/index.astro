---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getServices } from '../utils/sanity';
import heroBg from '../assets/images/hero-bg.jpg';

const services = await getServices();
// Always show 6 (fills both the 2- and 3-column grid evenly): featured
// projects first, topped up with the most recent non-featured ones.
const allProjects = await getProjects();
const highlightProjects = [
  ...allProjects.filter((p) => p.featured),
  ...allProjects.filter((p) => !p.featured),
].slice(0, 6);

const flagshipTitles = ['Panel Board Supply & Installation', 'Electrical Wiring & Installation'];
const flagshipServices = flagshipTitles
  .map((title) => services.find((s) => s.title === title))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const flagshipIds = new Set(flagshipServices.map((s) => s.id));
const secondaryServices = services.filter((s) => !flagshipIds.has(s.id));

const serviceIcons: Record<string, string> = {
  bolt: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M13 3l-4 9h6l-4 9" />`,
  'cloud-storm': `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 18a4.6 4.4 0 0 1 0 -9a5 4.5 0 0 1 11 2h1a3.5 3.5 0 0 1 0 7" /><path d="M13 14l-2 4l3 0l-2 4" />`,
  camera: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" /><circle cx="12" cy="13" r="3" />`,
  'shield-lock': `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
  plug: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9.785 6l-3.785 3.785a2 2 0 0 0 0 2.829l4.586 4.586a2 2 0 0 0 2.829 0l3.785 -3.785" /><path d="M10 15l-5 5" /><path d="M15 10l5 -5" /><path d="M7 7l1 1" /><path d="M16 16l1 1" />`,
  tool: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />`,
};

const stats = [
  { number: '23+', label: 'Years Active', unit: 'YRS' },
  { number: '200+', label: 'Projects Completed', unit: 'PROJ' },
  { number: '50+', label: 'Clients Served', unit: 'CLNT' },
].map((stat) => {
  const [, value, suffix] = stat.number.match(/^(\d+)(.*)$/) ?? [null, stat.number, ''];
  return { ...stat, value, suffix };
});

// Analog panel-meter dial (viewBox 0 0 100 100). The needle rests at the same
// "running normally" position on every meter: it signals the gauge is live,
// not a fake reading of the number, which has no meaningful full scale.
const DIAL = { cx: 50, cy: 66, r: 40, sweep: 50, rest: 18 };
const round = (n: number) => Math.round(n * 100) / 100;
const polar = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [round(DIAL.cx + r * Math.sin(a)), round(DIAL.cy - r * Math.cos(a))];
};
const arcPath = (from: number, to: number, r: number) => {
  const [x1, y1] = polar(from, r);
  const [x2, y2] = polar(to, r);
  return `M${x1} ${y1} A${r} ${r} 0 0 1 ${x2} ${y2}`;
};
const dialTicks = Array.from({ length: 21 }, (_, i) => {
  const deg = -DIAL.sweep + i * 5;
  const major = i % 5 === 0;
  const [x1, y1] = polar(deg, DIAL.r);
  const [x2, y2] = polar(deg, DIAL.r - (major ? 7 : 3.5));
  return { x1, y1, x2, y2, major };
});
const dialScale = arcPath(-DIAL.sweep, DIAL.sweep, DIAL.r);
const dialRedZone = arcPath(32, DIAL.sweep, DIAL.r + 2.5);

const whyUs = [
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/>`,
    title: '23 Years of Field-Proven Expertise',
    description:
      'Operating since 2003, our engineers bring decades of hands-on experience across the full spectrum of electrical systems in the Maldives.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>`,
    title: 'Island-Wide Coverage',
    description:
      'From Malé to remote atolls, we mobilise to every corner of the Republic — resorts, hospitals, commercial buildings, and residential projects.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 13l4 4l10 -10"/>`,
    title: 'End-to-End Project Delivery',
    description:
      'We handle design, supply, installation, testing, and ongoing maintenance — a single point of accountability from kickoff to commissioning.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
    title: 'Licensed & Safety-Certified',
    description:
      'All works comply with Maldivian electrical regulations and IEC standards, with full documentation and handover packages for every project.',
  },
];
---

<BaseLayout
  title="Electrical Engineering Services in the Maldives"
  description="Trusted electrical engineers in the Maldives since 2003. Panel boards, CCTV, access control, wiring and maintenance."
>

  <!-- ── SECTION 1: HERO (grounded in the trade) ── -->
  <section
    class="home-hero relative grid min-h-[min(calc(100dvh-4rem),68rem)] overflow-hidden bg-[#1a1a1a] lg:grid-cols-[11fr_9fr]"
  >
    <!-- Ambient circuit-trace texture -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.06]" aria-hidden="true">
      <defs>
        <pattern id="hero-circuit" width="130" height="130" patternUnits="userSpaceOnUse">
          <path d="M0 65 H45 V25 H100" stroke="white" stroke-width="1" fill="none" />
          <path d="M130 100 H85 V125" stroke="white" stroke-width="1" fill="none" />
          <path d="M65 0 V40 H130" stroke="white" stroke-width="1" fill="none" />
          <circle cx="45" cy="25" r="2.5" fill="white" />
          <circle cx="100" cy="25" r="2.5" fill="white" />
          <circle cx="85" cy="125" r="2.5" fill="white" />
          <circle cx="65" cy="40" r="2.5" fill="white" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-circuit)" />
    </svg>

    <!-- Text column -->
    <!-- On desktop the left padding uses the full-width frame gutter shared
         with the header, so the hero text lines up with the logo. -->
    <div class="relative z-10 flex flex-col justify-center px-6 py-20 sm:px-10 md:py-24 lg:py-16 lg:pl-frame lg:pr-12">
      <!-- Nameplate -->
      <div class="relative mb-8 inline-flex w-fit items-center gap-2.5 rounded-md border border-white/15 bg-gradient-to-b from-[#333333] to-[#1c1c1c] px-4 py-2.5 shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_3px_8px_rgba(0,0,0,0.4)]">
        <span class="absolute left-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute right-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute bottom-1 left-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute bottom-1 right-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#E31E24] shadow-[0_0_7px_rgba(227,30,36,0.9)]"></span>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-white/80">Multitec · Est. 2003 · IEC Compliant</span>
      </div>

      <!-- Headline with breaker-tick -->
      <div class="flex items-start gap-5">
        <div class="relative mt-2.5 h-28 w-1.5 shrink-0 2xl:mt-4 2xl:h-36 rounded-full bg-gradient-to-b from-[#E31E24] to-[#8f1116]">
          <!-- Single-line-diagram feed: a trace runs in from the screen edge
               and terminates at the breaker-tick, filling the wide-screen gutter. -->
          <span class="hero-trace" aria-hidden="true">
            <span class="hero-trace-pulse"></span>
            <span class="hero-trace-node hero-trace-node--near"></span>
            <span class="hero-trace-node hero-trace-node--far"></span>
          </span>
          <span class="hero-tick-dot absolute -left-1 -top-2 h-3.5 w-3.5 rounded-full bg-[#E31E24] shadow-[0_0_12px_rgba(227,30,36,0.7)]"></span>
        </div>
        <h1 class="font-display max-w-lg text-4xl font-black leading-[1.06] tracking-tight text-white sm:text-5xl lg:text-[3.25rem] 2xl:max-w-2xl 2xl:text-[4.25rem]">
          Powering the Maldives with Precision &amp; Expertise
        </h1>
      </div>

      <p class="ml-7 mt-6 max-w-md text-base leading-relaxed text-white/60 md:text-lg 2xl:max-w-xl 2xl:text-xl">
        End-to-end electrical solutions — panel boards, CCTV, lightning protection, and more.
        Serving every island of the Republic.
      </p>

      <div class="ml-7 mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/projects" class="btn btn-primary shadow-lg">
          View Our Projects
        </a>
        <a
          href="/contact"
          class="btn btn-outline border-white/25 text-white hover:border-white hover:bg-white hover:text-[#1a1a1a]"
        >
          Get in Touch
        </a>
      </div>

      <!-- Hero stats, styled as panel instruments that "power on" once the
           circuit pulse reaches the breaker-tick. Two designs for comparison:
           B = digital readouts (default), C = analog panel meters (?stats=c). -->
      <div class="ml-7 mt-12" data-hero-stats data-stats-variant="b">

        <!-- Variant B: digital meter readouts -->
        <dl class="stats-readout grid w-full max-w-md grid-cols-3 divide-x divide-white/10 overflow-hidden rounded-lg border border-white/10 bg-[#121212] shadow-[inset_0_2px_8px_rgba(0,0,0,0.7),0_1px_0_rgba(255,255,255,0.06)]">
          {stats.map((stat) => (
            <div class="readout-cell flex flex-col gap-2 px-3.5 py-3.5 sm:px-5">
              <dt class="order-2 text-[11px] leading-tight text-white/55">{stat.label}</dt>
              <dd class="order-1 flex items-center gap-2">
                <span class="readout-led h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
                <span class="readout-display font-display text-2xl font-bold leading-none tabular-nums sm:text-[1.75rem]">
                  <span class="readout-digits inline-block text-right" style={`min-width: ${stat.value.length}ch`} data-target-value={stat.value}>{stat.value}</span><span class="readout-suffix">{stat.suffix}</span>
                </span>
              </dd>
            </div>
          ))}
        </dl>

        <!-- Variant C: analog panel meters -->
        <dl class="stats-gauges grid w-full max-w-md grid-cols-3 gap-3">
          {stats.map((stat) => (
            <div class="gauge flex flex-col items-center text-center">
              <dt class="order-2 mt-1 text-[11px] leading-tight text-white/55">{stat.label}</dt>
              <dd class="order-1 flex flex-col items-center">
                <span class="gauge-bezel relative block h-[84px] w-[84px] rounded-md p-[5px] lg:h-24 lg:w-24" aria-hidden="true">
                  <span class="gauge-lamp absolute right-1.5 top-1.5 h-1 w-1 rounded-full"></span>
                  <svg viewBox="0 0 100 100" class="h-full w-full">
                    <rect x="0" y="0" width="100" height="100" rx="5" fill="#161616" />
                    <path d={dialScale} fill="none" stroke="rgb(255 255 255 / 0.35)" stroke-width="1" />
                    <path d={dialRedZone} fill="none" stroke="#E31E24" stroke-width="3.5" />
                    {dialTicks.map((t) => (
                      <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={t.major ? 'rgb(255 255 255 / 0.75)' : 'rgb(255 255 255 / 0.35)'} stroke-width={t.major ? 1.6 : 0.9} />
                    ))}
                    <text x="50" y="86" text-anchor="middle" font-size="8" font-weight="600" letter-spacing="1" fill="rgb(255 255 255 / 0.4)">{stat.unit}</text>
                    <g data-needle data-rest={DIAL.rest} transform={`rotate(${DIAL.rest} ${DIAL.cx} ${DIAL.cy})`}>
                      <line x1={DIAL.cx} y1={DIAL.cy + 6} x2={DIAL.cx} y2={DIAL.cy - DIAL.r + 3} stroke="#ff3a40" stroke-width="1.6" stroke-linecap="round" />
                    </g>
                    <circle cx={DIAL.cx} cy={DIAL.cy} r="3.5" fill="#2a2a2a" stroke="rgb(255 255 255 / 0.3)" stroke-width="0.8" />
                    <rect x="0" y="0" width="100" height="50" rx="5" fill="url(#gauge-glass)" />
                  </svg>
                </span>
                <span class="mt-2 font-display text-xl font-bold leading-none text-white tabular-nums">
                  <span class="gauge-digits inline-block text-right" style={`min-width: ${stat.value.length}ch`} data-target-value={stat.value}>{stat.value}</span>{stat.suffix}
                </span>
              </dd>
            </div>
          ))}
        </dl>
        <svg width="0" height="0" class="absolute" aria-hidden="true">
          <defs>
            <linearGradient id="gauge-glass" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity="0.07" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>

        <!-- Runs during parsing, before first paint: picks the variant
             (TEMPORARY ?stats= comparison) and, unless reduced motion is on,
             puts the instruments in their "off" state so the power-on
             animation never flashes the final values first. -->
        <script is:inline>
          (() => {
            const root = document.currentScript.parentElement;
            const v = new URLSearchParams(location.search).get('stats');
            if (v === 'b' || v === 'c') root.dataset.statsVariant = v;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            root.dataset.armed = '';
            root.querySelectorAll('[data-needle]').forEach((n) => n.setAttribute('transform', 'rotate(-50 50 66)'));
          })();
        </script>
      </div>

      <script>
        import { gsap } from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);

        const LED_ON = { backgroundColor: '#ff3a40', boxShadow: '0 0 8px 2px rgba(255, 58, 64, 0.75)' };

        function countUp(tl: gsap.core.Timeline, el: HTMLElement, at: number, duration: number) {
          const target = Number(el.dataset.targetValue);
          const counter = { val: 0 };
          el.textContent = '0';
          tl.to(counter, {
            val: target,
            duration,
            ease: 'power2.out',
            onUpdate: () => { el.textContent = String(Math.round(counter.val)); },
          }, at);
        }

        function powerReadouts(root: HTMLElement, delay: number) {
          const tl = gsap.timeline({ delay });
          root.querySelectorAll<HTMLElement>('.readout-cell').forEach((cell, i) => {
            const at = i * 0.28;
            const digits = cell.querySelector<HTMLElement>('.readout-digits')!;
            const suffix = cell.querySelector<HTMLElement>('.readout-suffix')!;
            tl.to(cell.querySelector('.readout-led'), { ...LED_ON, duration: 0.08 }, at);
            // A display warming up: a couple of uneven flickers, then steady.
            tl.to([digits, suffix], { keyframes: { opacity: [0, 1, 0.2, 0.9, 0.5, 1] }, duration: 0.4, ease: 'none' }, at + 0.06);
            countUp(tl, digits, at + 0.06, 1.1);
          });
        }

        function powerGauges(root: HTMLElement, delay: number) {
          const tl = gsap.timeline({ delay });
          root.querySelectorAll<HTMLElement>('.gauge').forEach((gauge, i) => {
            const at = i * 0.22;
            const needle = gauge.querySelector<SVGGElement>('[data-needle]')!;
            const digits = gauge.querySelector<HTMLElement>('.gauge-digits')!;
            const rest = Number(needle.dataset.rest);
            // Hand the armed pose over to GSAP's own transform tracking.
            needle.removeAttribute('transform');
            gsap.set(needle, { rotation: -50, svgOrigin: '50 66' });

            tl.to(gauge.querySelector('.gauge-lamp'), { ...LED_ON, duration: 0.08 }, at);
            // Power-on self-test: needle swings to full scale, then settles.
            tl.to(needle, { rotation: 50, svgOrigin: '50 66', duration: 0.45, ease: 'power2.in' }, at + 0.05);
            tl.to(needle, { rotation: rest, svgOrigin: '50 66', duration: 1.4, ease: 'elastic.out(1, 0.35)' }, at + 0.5);
            tl.to(digits, { opacity: 1, duration: 0.2 }, at + 0.05);
            countUp(tl, digits, at + 0.05, 1.4);
          });
        }

        function initHeroStats() {
          const root = document.querySelector<HTMLElement>('[data-hero-stats]');
          if (!root || root.dataset.statsBound === 'true') return;
          root.dataset.statsBound = 'true';
          ScrollTrigger.getById('hero-stats')?.kill();

          if (!('armed' in root.dataset)) return; // reduced motion: static final values

          // On wide screens the circuit pulse runs into the breaker-tick first
          // (CSS, ~1.8s); the instruments power on right as it arrives.
          const initAt = performance.now();
          const trace = document.querySelector('.hero-trace');
          const fedByTrace = !!trace && getComputedStyle(trace).display !== 'none';

          ScrollTrigger.create({
            id: 'hero-stats',
            trigger: root,
            start: 'top 92%',
            once: true,
            onEnter: () => {
              const elapsed = (performance.now() - initAt) / 1000;
              const delay = fedByTrace ? Math.max(0.15, 1.75 - elapsed) : 0.15;
              if (root.dataset.statsVariant === 'c') powerGauges(root, delay);
              else powerReadouts(root, delay);
            },
          });
        }

        initHeroStats();
        document.addEventListener('astro:page-load', initHeroStats);
      </script>
    </div>

    <!-- Image column -->
    <div class="relative hidden min-h-[420px] lg:block">
      <div class="hero-photo absolute inset-0 bg-[#111]">
        <Image
          src={heroBg}
          alt="Multitec Maldives electrical engineering work"
          width={2400}
          quality={90}
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-photo-scrim absolute inset-0"></div>
      </div>

      <!-- Credential badge — compact, anchored to the bottom of the photo -->
      <div class="absolute bottom-10 left-6 flex w-fit items-center gap-3 rounded-xl border border-white/10 bg-[#0f0f0f]/85 p-3.5 backdrop-blur">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 13l4 4l10 -10" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-white">URA-Approved Installations</p>
          <p class="mt-0.5 text-[11px] text-white/50">Drawings approved before energisation</p>
        </div>
      </div>
    </div>

    <!-- Scroll cue — desktop only, where the hero fills the viewport and the
         fold cut isn't obvious. Links to the next section so it's a real
         affordance, not just decoration. -->
    <a
      href="#services-heading"
      class="scroll-bounce absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 text-white/40 transition-colors hover:text-white/70 lg:flex"
      aria-label="Scroll to explore our services"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6l6 -6" />
      </svg>
    </a>
  </section>

  <!-- ── SECTION 2: SERVICES ── -->
  <section class="bg-white pb-20 pt-12 md:pb-28 md:pt-16" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          What We Do
        </p>
        <h2 id="services-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Our Services
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          Comprehensive electrical engineering solutions — delivered with the precision and
          reliability the Maldives demands.
        </p>
      </header>

      <!-- Flagship services: Panel Board Supply & Electrical Wiring — the two most requested -->
      <div class="grid gap-6 lg:grid-cols-2">
        {flagshipServices.map((service, i) => (
          i === 0 ? (
            <article class="group relative overflow-hidden rounded-2xl bg-[#111]" data-animate>
              <Image
                src={heroBg}
                alt=""
                width={1300}
                quality={85}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/10"></div>
              <div class="relative flex min-h-72 flex-col justify-between p-7">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#E31E24]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={serviceIcons[service.icon] ?? serviceIcons.bolt} />
                </div>
                <div>
                  <h3 class="font-display text-xl font-bold text-white">{service.title}</h3>
                  <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/70">{service.shortDescription}</p>
                  <a href={`/services#${service.id}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-white hover:underline">
                    Learn more<span class="sr-only"> about {service.title}</span>
