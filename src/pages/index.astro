---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects, getServices } from '../utils/sanity';

const services = await getServices();
const featuredProjects = await getFeaturedProjects();

const stats = [
  { number: '23+', label: 'Years Active' },
  { number: '200+', label: 'Projects Completed' },
  { number: '50+', label: 'Clients Served' },
];

const whyUs = [
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/>`,
    title: '23 Years of Field-Proven Expertise',
    description:
      'Operating since 2003, our engineers bring decades of hands-on experience across the full spectrum of electrical systems in the Maldives.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>`,
    title: 'Island-Wide Coverage',
    description:
      'From Malé to remote atolls, we mobilise to every corner of the Republic — resorts, hospitals, commercial buildings, and residential projects.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 13l4 4l10 -10"/>`,
    title: 'End-to-End Project Delivery',
    description:
      'We handle design, supply, installation, testing, and ongoing maintenance — a single point of accountability from kickoff to commissioning.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
    title: 'Licensed & Safety-Certified',
    description:
      'All works comply with Maldivian electrical regulations and IEC standards, with full documentation and handover packages for every project.',
  },
];
---

<BaseLayout
  title="Electrical Engineering Services in the Maldives"
  description="Trusted electrical engineers in the Maldives since 2003. Panel boards, CCTV, access control, wiring and maintenance."
>

  <!-- ── SECTION 1: HERO (split) ── -->
  <section class="relative grid min-h-dvh overflow-hidden bg-[#1a1a1a] lg:grid-cols-2">
    <!-- Text column -->
    <div class="flex flex-col justify-center px-6 py-20 sm:px-10 md:py-28 lg:px-16 lg:py-32">
      <span
        class="mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-[#E31E24]/30 bg-[#E31E24]/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[#E31E24]"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#E31E24]"></span>
        Trusted Electrical Engineering — Since 2003
      </span>

      <h1 class="font-display max-w-lg text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-[3.25rem]">
        Powering the Maldives with <span class="text-[#E31E24]">Precision &amp; Expertise</span>
      </h1>

      <p class="mt-6 max-w-md text-base leading-relaxed text-white/60 md:text-lg">
        End-to-end electrical solutions — panel boards, CCTV, lightning protection, and more.
        Serving every island of the Republic.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/projects" class="btn btn-primary shadow-lg">
          View Our Projects
        </a>
        <a
          href="/contact"
          class="btn btn-outline border-white/25 text-white hover:border-white hover:bg-white hover:text-[#1a1a1a]"
        >
          Get in Touch
        </a>
      </div>

      <!-- Stats -->
      <dl class="mt-12 flex gap-0 border-t border-white/10 pt-7">
        {stats.map((stat, i) => (
          <div class={`flex flex-col ${i < stats.length - 1 ? 'mr-8 border-r border-white/10 pr-8' : ''}`}>
            <dt class="font-display text-3xl font-bold tracking-tight text-[#E31E24]">{stat.number}</dt>
            <dd class="mt-1 text-xs font-medium uppercase tracking-wide text-white/40">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Image column -->
    <div class="relative hidden min-h-[420px] bg-[#111] lg:block">
      <Image
        src="/images/company/hero-bg.jpg"
        alt="Multitec Maldives electrical engineering work"
        width={900}
        height={1050}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-l from-transparent via-transparent to-[#1a1a1a]/30"></div>

      <!-- Floating credibility badge -->
      <div class="absolute bottom-10 left-10 right-10 flex items-center gap-4 rounded-2xl border border-white/10 bg-[#0f0f0f]/80 p-5 backdrop-blur">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 13l4 4l10 -10" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">IEC Standards Certified</p>
          <p class="mt-0.5 text-xs text-white/50">Full documentation on every project</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 2: SERVICES ── -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          What We Do
        </p>
        <h2 id="services-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Our Services
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          Comprehensive electrical engineering solutions — delivered with the precision and
          reliability the Maldives demands.
        </p>
      </header>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

      <div class="mt-12 text-center" data-animate>
        <a
          href="/services"
          class="btn btn-outline border-[#1a1a1a] text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white"
        >
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 3: FEATURED PROJECTS ── -->
  <section class="bg-[#FAFAFA] py-20 md:py-28" aria-labelledby="projects-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          Our Work
        </p>
        <h2 id="projects-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Project Highlights
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          A snapshot of our work across the Maldives.
        </p>
      </header>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <div class="mt-12 text-center" data-animate>
        <a
          href="/projects"
          class="btn btn-outline border-[#1a1a1a] text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white"
        >
          View All Projects
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 4: WHY CHOOSE US ── -->
  <section class="bg-[#F5F5F5] py-20 md:py-28" aria-labelledby="why-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          Why Multitec
        </p>
        <h2 id="why-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Why Choose Us?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          We've built our reputation on technical excellence, reliability, and a deep
          understanding of what it takes to deliver in island conditions.
        </p>
      </header>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {whyUs.map((point, i) => {
          const isLast = i === whyUs.length - 1;
          return (
            <article
              class={`flex flex-col rounded-2xl p-7 ${isLast ? 'bg-[#1a1a1a]' : 'border border-black/5 bg-white'}`}
              data-animate
            >
              <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${isLast ? 'bg-[#E31E24]/15' : 'bg-[#E31E24]/10'} text-[#E31E24]`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={point.icon}
                />
              </div>
              <h3 class={`font-display mt-5 text-base font-semibold ${isLast ? 'text-white' : 'text-[#1a1a1a]'}`}>{point.title}</h3>
              <p class={`mt-2 text-sm leading-relaxed ${isLast ? 'text-white/50' : 'text-[#4a4a4a]'}`}>{point.description}</p>
              {isLast && (
                <a href="/contact" class="mt-5 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-[#E31E24] hover:underline">
                  Get in Touch
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" />
                  </svg>
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── SECTION 5: CTA BANNER ── -->
  <CtaBanner
    heading="Ready to Start Your Project?"
    subtext="Talk to our engineers about your electrical requirements — whether it's a single installation or a large-scale fitout."
    buttonText="Get in Touch"
    buttonLink="/contact"
  />

</BaseLayout>
