<style>
  /* Desktop hero: the photo bleeds left and fades into the dark side, and a
     circuit trace feeds the breaker-tick from the screen edge. Mobile hides
     the photo column and trace entirely. */
  .hero-trace {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-photo {
      left: -14vw;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 45%);
      mask-image: linear-gradient(to right, transparent 0%, #000 45%);
    }
    .hero-photo-scrim {
      background: linear-gradient(to right, rgb(26 26 26 / 0.5), rgb(26 26 26 / 0) 55%);
    }
  }

  /* Trace spans exactly from the screen edge to the breaker-tick: its width
     is the same frame gutter as the text column's left padding. Below 1280px that gutter is too
     narrow to read as a line, so it's only shown from there up. */
  @media (min-width: 1280px) {
    .hero-trace {
      display: block;
      position: absolute;
      right: 100%;
      top: -2px;
      width: var(--spacing-frame);
      height: 2px;
      background: linear-gradient(to right, rgb(227 30 36 / 0.3), rgb(227 30 36 / 0.9));
    }
  }

  .hero-trace-node {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    border: 1.5px solid #e31e24;
    border-radius: 9999px;
    background: #1a1a1a;
    transform: translate(50%, -50%);
  }
  .hero-trace-node--near {
    right: 30%;
  }
  .hero-trace-node--far {
    right: 70%;
  }

  .hero-trace-pulse {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent calc(100% - 7rem),
      #ff8a8d calc(100% - 0.75rem),
      transparent 100%
    );
    filter: drop-shadow(0 0 4px rgb(255 80 85 / 0.9));
    transform: translateX(-100%);
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-trace-pulse {
      animation: hero-trace-pulse 1.3s cubic-bezier(0.55, 0, 0.35, 1) 0.5s forwards;
    }
    .hero-tick-dot {
      animation: hero-tick-flare 0.7s ease-out 1.7s;
    }
  }

  @keyframes hero-trace-pulse {
    0% { transform: translateX(-100%); opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateX(0); opacity: 0; }
  }

  @keyframes hero-tick-flare {
    35% {
      transform: scale(1.3);
      box-shadow: 0 0 26px 6px rgb(227 30 36 / 0.95);
    }
  }

  /* ── Hero stats instruments ── */
  [data-stats-variant='b'] .stats-gauges,
  [data-stats-variant='c'] .stats-readout {
    display: none;
  }

  /* B: glowing LED-meter digits. */
  .readout-digits,
  .readout-suffix {
    color: #ff3a40;
    text-shadow: 0 0 10px rgb(255 58 64 / 0.45);
  }
  .readout-suffix {
    margin-left: 1px;
    font-size: 0.7em;
  }

  /* C: metal bezel around each meter face. */
  .gauge-bezel {
    background: linear-gradient(145deg, #3a3a3a, #1b1b1b);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 4px 10px rgb(0 0 0 / 0.5),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }

  /* Indicator lamps are lit at rest; the armed (pre-animation) state turns
     them off until GSAP powers them on. */
  .readout-led,
  .gauge-lamp {
    background: #ff3a40;
    box-shadow: 0 0 8px 2px rgb(255 58 64 / 0.75);
  }
  [data-armed] .readout-led,
  [data-armed] .gauge-lamp {
    background: #3b1416;
    box-shadow: none;
    animation: stats-lamp-failsafe 0s 4s forwards;
  }
  [data-armed] .readout-digits,
  [data-armed] .readout-suffix,
  [data-armed] .gauge-digits {
    opacity: 0;
    animation: stats-value-failsafe 0s 4s forwards;
  }
  /* Failsafe: if the animation script never runs, everything still lights up
     after 4s rather than leaving the stats blank. */
  @keyframes stats-value-failsafe {
    to { opacity: 1; }
  }
  @keyframes stats-lamp-failsafe {
    to {
      background: #ff3a40;
      box-shadow: 0 0 8px 2px rgb(255 58 64 / 0.75);
    }
  }
</style>
