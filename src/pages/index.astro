---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects, getServices } from '../utils/sanity';

const services = await getServices();
const featuredProjects = await getFeaturedProjects();

const flagshipTitles = ['Panel Board Supply & Installation', 'Electrical Wiring & Installation'];
const flagshipServices = flagshipTitles
  .map((title) => services.find((s) => s.title === title))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const flagshipIds = new Set(flagshipServices.map((s) => s.id));
const secondaryServices = services.filter((s) => !flagshipIds.has(s.id));

const serviceIcons: Record<string, string> = {
  bolt: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M13 3l-4 9h6l-4 9" />`,
  'cloud-storm': `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 18a4.6 4.4 0 0 1 0 -9a5 4.5 0 0 1 11 2h1a3.5 3.5 0 0 1 0 7" /><path d="M13 14l-2 4l3 0l-2 4" />`,
  camera: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" /><circle cx="12" cy="13" r="3" />`,
  'shield-lock': `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
  plug: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9.785 6l-3.785 3.785a2 2 0 0 0 0 2.829l4.586 4.586a2 2 0 0 0 2.829 0l3.785 -3.785" /><path d="M10 15l-5 5" /><path d="M15 10l5 -5" /><path d="M7 7l1 1" /><path d="M16 16l1 1" />`,
  tool: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />`,
};

const stats = [
  { number: '23+', label: 'Years Active' },
  { number: '200+', label: 'Projects Completed' },
  { number: '50+', label: 'Clients Served' },
];

const whyUs = [
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/>`,
    title: '23 Years of Field-Proven Expertise',
    description:
      'Operating since 2003, our engineers bring decades of hands-on experience across the full spectrum of electrical systems in the Maldives.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>`,
    title: 'Island-Wide Coverage',
    description:
      'From Malé to remote atolls, we mobilise to every corner of the Republic — resorts, hospitals, commercial buildings, and residential projects.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 13l4 4l10 -10"/>`,
    title: 'End-to-End Project Delivery',
    description:
      'We handle design, supply, installation, testing, and ongoing maintenance — a single point of accountability from kickoff to commissioning.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
    title: 'Licensed & Safety-Certified',
    description:
      'All works comply with Maldivian electrical regulations and IEC standards, with full documentation and handover packages for every project.',
  },
];
---

<BaseLayout
  title="Electrical Engineering Services in the Maldives"
  description="Trusted electrical engineers in the Maldives since 2003. Panel boards, CCTV, access control, wiring and maintenance."
>

  <!-- ── SECTION 1: HERO (grounded in the trade) ── -->
  <section class="relative grid min-h-dvh overflow-hidden bg-[#1a1a1a] lg:grid-cols-2">
    <!-- Ambient circuit-trace texture -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.06]" aria-hidden="true">
      <defs>
        <pattern id="hero-circuit" width="130" height="130" patternUnits="userSpaceOnUse">
          <path d="M0 65 H45 V25 H100" stroke="white" stroke-width="1" fill="none" />
          <path d="M130 100 H85 V125" stroke="white" stroke-width="1" fill="none" />
          <path d="M65 0 V40 H130" stroke="white" stroke-width="1" fill="none" />
          <circle cx="45" cy="25" r="2.5" fill="white" />
          <circle cx="100" cy="25" r="2.5" fill="white" />
          <circle cx="85" cy="125" r="2.5" fill="white" />
          <circle cx="65" cy="40" r="2.5" fill="white" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-circuit)" />
    </svg>

    <!-- Text column -->
    <div class="relative z-10 flex flex-col justify-center px-6 py-20 sm:px-10 md:py-28 lg:px-16 lg:py-32">
      <!-- Nameplate -->
      <div class="relative mb-8 inline-flex w-fit items-center gap-2.5 rounded-md border border-white/15 bg-gradient-to-b from-[#333333] to-[#1c1c1c] px-4 py-2.5 shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_3px_8px_rgba(0,0,0,0.4)]">
        <span class="absolute left-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute right-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute bottom-1 left-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute bottom-1 right-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#E31E24] shadow-[0_0_7px_rgba(227,30,36,0.9)]"></span>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-white/80">Multitec · Est. 2003 · IEC Compliant</span>
      </div>

      <!-- Headline with breaker-tick -->
      <div class="flex items-start gap-5">
        <div class="relative mt-2.5 h-28 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#E31E24] to-[#8f1116]">
          <span class="absolute -left-1 -top-2 h-3.5 w-3.5 rounded-full bg-[#E31E24] shadow-[0_0_12px_rgba(227,30,36,0.7)]"></span>
        </div>
        <h1 class="font-display max-w-lg text-4xl font-black leading-[1.06] tracking-tight text-white sm:text-5xl lg:text-[3.25rem]">
          Powering the Maldives with Precision &amp; Expertise
        </h1>
      </div>

      <p class="ml-7 mt-6 max-w-md text-base leading-relaxed text-white/60 md:text-lg">
        End-to-end electrical solutions — panel boards, CCTV, lightning protection, and more.
        Serving every island of the Republic.
      </p>

      <div class="ml-7 mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/projects" class="btn btn-primary shadow-lg">
          View Our Projects
        </a>
        <a
          href="/contact"
          class="btn btn-outline border-white/25 text-white hover:border-white hover:bg-white hover:text-[#1a1a1a]"
        >
          Get in Touch
        </a>
      </div>

      <!-- Meter-style stats -->
      <dl class="ml-7 mt-12 flex gap-10">
        {stats.map((stat, i) => {
          const dashoffsets = [34, 20, 55];
          return (
            <div class="flex flex-col items-start">
              <div class="relative flex h-[66px] w-[66px] items-center justify-center">
                <svg width="66" height="66" class="absolute inset-0 -rotate-90">
                  <circle cx="33" cy="33" r="27" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="3" />
                  <circle cx="33" cy="33" r="27" fill="none" stroke="#E31E24" stroke-width="3" stroke-dasharray="169.6" stroke-dashoffset={dashoffsets[i]} stroke-linecap="round" />
                </svg>
                <dt class="font-display text-base font-extrabold text-white">{stat.number}</dt>
              </div>
              <dd class="mt-2 text-xs text-white/45">{stat.label}</dd>
            </div>
          );
        })}
      </dl>
    </div>

    <!-- Image column -->
    <div class="relative hidden min-h-[420px] bg-[#111] lg:block">
      <Image
        src="/images/company/hero-bg.jpg"
        alt="Multitec Maldives electrical engineering work"
        width={900}
        height={1050}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-l from-transparent via-transparent to-[#1a1a1a]/30"></div>

      <!-- Credential badge — overlaps the column boundary -->
      <div class="absolute bottom-16 left-10 right-10 flex items-center gap-4 rounded-2xl border border-white/10 bg-[#0f0f0f]/85 p-5 backdrop-blur lg:-left-16 lg:bottom-20">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 13l4 4l10 -10" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">IEC Standards Compliant</p>
          <p class="mt-0.5 text-xs text-white/50">Full documentation on every project</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 2: SERVICES ── -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          What We Do
        </p>
        <h2 id="services-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Our Services
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          Comprehensive electrical engineering solutions — delivered with the precision and
          reliability the Maldives demands.
        </p>
      </header>

      <!-- Flagship services: Panel Board Supply & Electrical Wiring — the two most requested -->
      <div class="grid gap-6 lg:grid-cols-2">
        {flagshipServices.map((service, i) => (
          i === 0 ? (
            <article class="group relative overflow-hidden rounded-2xl bg-[#111]" data-animate>
              <Image
                src="/images/company/hero-bg.jpg"
                alt=""
                width={900}
                height={700}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/10"></div>
              <div class="relative flex min-h-72 flex-col justify-between p-7">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#E31E24]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={serviceIcons[service.icon] ?? serviceIcons.bolt} />
                </div>
                <div>
                  <span class="mb-3 inline-block rounded-full bg-white/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-white">
                    Most Requested
                  </span>
                  <h3 class="font-display text-xl font-bold text-white">{service.title}</h3>
                  <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/70">{service.shortDescription}</p>
                  <a href={`/services#${service.id}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-white hover:underline">
                    Learn more
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg>
                  </a>
                </div>
              </div>
            </article>
          ) : (
            <article class="flex min-h-72 flex-col gap-6 rounded-2xl border border-t-4 border-base-200 border-t-[#E31E24] bg-white p-7" data-animate>
              <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#E31E24]/10 text-[#E31E24]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={serviceIcons[service.icon] ?? serviceIcons.bolt} />
              </div>
              <div>
                <span class="mb-3 inline-block rounded-full bg-[#E31E24]/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-[#E31E24]">
                  Most Requested
                </span>
                <h3 class="font-display text-xl font-bold text-[#1a1a1a]">{service.title}</h3>
                <p class="mt-2 max-w-sm text-sm leading-relaxed text-[#4a4a4a]">{service.shortDescription}</p>
                <a href={`/services#${service.id}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#E31E24] hover:underline">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg>
                </a>
              </div>
            </article>
          )
        ))}
      </div>

      <!-- Secondary services -->
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {secondaryServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

      <div class="mt-12 text-center" data-animate>
        <a
          href="/services"
          class="btn btn-outline border-[#1a1a1a] text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white"
        >
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 3: FEATURED PROJECTS ── -->
  <section class="bg-[#FAFAFA] py-20 md:py-28" aria-labelledby="projects-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          Our Work
        </p>
        <h2 id="projects-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Project Highlights
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          A snapshot of our work across the Maldives.
        </p>
      </header>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <div class="mt-12 text-center" data-animate>
        <a
          href="/projects"
          class="btn btn-outline border-[#1a1a1a] text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white"
        >
          View All Projects
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 4: WHY CHOOSE US ── -->
  <section class="bg-[#F5F5F5] py-20 md:py-28" aria-labelledby="why-heading">
    <div class="mx-auto max-w-6xl px-6">
      <header class="mb-14 text-center" data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#E31E24]">
          Why Multitec
        </p>
        <h2 id="why-heading" class="font-display text-3xl font-bold text-[#1a1a1a] md:text-4xl">
          Why Choose Us?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#4a4a4a]">
          We've built our reputation on technical excellence, reliability, and a deep
          understanding of what it takes to deliver in island conditions.
        </p>
      </header>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {whyUs.map((point, i) => {
          const isLast = i === whyUs.length - 1;
          return (
            <article
              class={`flex flex-col rounded-2xl p-7 ${isLast ? 'bg-[#1a1a1a]' : 'border border-black/5 bg-white'}`}
              data-animate
            >
              <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${isLast ? 'bg-[#E31E24]/15' : 'bg-[#E31E24]/10'} text-[#E31E24]`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={point.icon}
                />
              </div>
              <h3 class={`font-display mt-5 text-base font-semibold ${isLast ? 'text-white' : 'text-[#1a1a1a]'}`}>{point.title}</h3>
              <p class={`mt-2 text-sm leading-relaxed ${isLast ? 'text-white/50' : 'text-[#4a4a4a]'}`}>{point.description}</p>
              {isLast && (
                <a href="/contact" class="mt-5 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-[#E31E24] hover:underline">
                  Get in Touch
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" />
                  </svg>
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── SECTION 5: CTA BANNER ── -->
  <CtaBanner
    heading="Ready to Start Your Project?"
    subtext="Talk to our engineers about your electrical requirements — whether it's a single installation or a large-scale fitout."
    buttonText="Get in Touch"
    buttonLink="/contact"
  />

</BaseLayout>
