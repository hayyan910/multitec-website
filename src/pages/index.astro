---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<BaseLayout
  title="Home"
  description="Multitec Maldives Pvt. Ltd. — professional electrical engineering services across the Maldives. Installations, design, solar PV, maintenance and more."
>
  <section class="flex min-h-[70vh] items-center justify-center px-4">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-[#1a1a1a] md:text-6xl">
        Electrical Engineering<br />
        <span class="text-[#E31E24]">Excellence</span>
      </h1>
      <p class="mt-6 text-lg text-[#4a4a4a]">Home page — full design coming soon.</p>
    </div>
  </section>

  <CtaBanner
    heading="Ready to Start Your Project?"
    subtext="Get in touch with our team for a no-obligation consultation."
    buttonText="Contact Us"
    buttonLink="/contact"
  />
</BaseLayout>
