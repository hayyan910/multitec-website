---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceExplorer from '../components/ServiceExplorer.astro';
import ProjectMap from '../components/ProjectMap.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getServices } from '../utils/sanity';
import heroBg from '../assets/images/hero-bg.jpg';
import SegmentDisplay from '../components/SegmentDisplay.astro';

const services = await getServices();
// Always show 6 (fills both the 2- and 3-column grid evenly): featured
// projects first, topped up with the most recent non-featured ones.
const allProjects = await getProjects();
const highlightProjects = [
  ...allProjects.filter((p) => p.featured),
  ...allProjects.filter((p) => !p.featured),
].slice(0, 6);

const stats = [
  { number: '23+', label: 'Years Active' },
  { number: '200+', label: 'Projects Completed' },
  { number: '50+', label: 'Clients Served' },
].map((stat) => {
  const [, value, suffix] = stat.number.match(/^(\d+)(.*)$/) ?? [null, stat.number, ''];
  return { ...stat, value, suffix };
});

const whyUs = [
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/>`,
    title: '23 Years of Field-Proven Expertise',
    description:
      'Operating since 2003, our engineers bring decades of hands-on experience across the full spectrum of electrical systems in the Maldives.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>`,
    title: 'Island-Wide Coverage',
    description:
      'From Malé to remote atolls, we mobilise to every corner of the Republic — resorts, hospitals, commercial buildings, and residential projects.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 13l4 4l10 -10"/>`,
    title: 'End-to-End Project Delivery',
    description:
      'We handle design, supply, installation, testing, and ongoing maintenance — a single point of accountability from kickoff to commissioning.',
  },
  {
    icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><circle cx="12" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M12 12l0 2.5"/>`,
    title: 'Licensed & Safety-Certified',
    description:
      'All works comply with Maldivian electrical regulations and IEC standards, with full documentation and handover packages for every project.',
  },
];
---

<BaseLayout
  title="Electrical Engineering Services in the Maldives"
  description="Trusted electrical engineers in the Maldives since 2003. Panel boards, CCTV, access control, wiring and maintenance."
>

  <!-- ── SECTION 1: HERO (grounded in the trade) ── -->
  <section
    class="home-hero relative grid min-h-[min(calc(100dvh-4rem),68rem)] overflow-hidden bg-[#1a1a1a] lg:grid-cols-[11fr_9fr]"
  >
    <!-- Ambient circuit-trace texture -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.06]" aria-hidden="true">
      <defs>
        <pattern id="hero-circuit" width="130" height="130" patternUnits="userSpaceOnUse">
          <path d="M0 65 H45 V25 H100" stroke="white" stroke-width="1" fill="none" />
          <path d="M130 100 H85 V125" stroke="white" stroke-width="1" fill="none" />
          <path d="M65 0 V40 H130" stroke="white" stroke-width="1" fill="none" />
          <circle cx="45" cy="25" r="2.5" fill="white" />
          <circle cx="100" cy="25" r="2.5" fill="white" />
          <circle cx="85" cy="125" r="2.5" fill="white" />
          <circle cx="65" cy="40" r="2.5" fill="white" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-circuit)" />
    </svg>

    <!-- Text column -->
    <!-- On desktop the left padding uses the full-width frame gutter shared
         with the header, so the hero text lines up with the logo. -->
    <div class="relative z-10 flex flex-col justify-center px-6 py-20 sm:px-10 md:py-24 lg:py-16 lg:pl-frame lg:pr-12">
      <!-- Nameplate -->
      <div class="relative mb-8 inline-flex w-fit items-center gap-2.5 rounded-md border border-white/15 bg-gradient-to-b from-[#333333] to-[#1c1c1c] px-4 py-2.5 shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_3px_8px_rgba(0,0,0,0.4)]">
        <span class="absolute left-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute right-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute bottom-1 left-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="absolute bottom-1 right-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]"></span>
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#E31E24] shadow-[0_0_7px_rgba(227,30,36,0.9)]"></span>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-white/80">Multitec · Est. 2003 · IEC Compliant</span>
      </div>

      <!-- Headline with breaker-tick -->
      <div class="flex items-start gap-5">
        <div class="relative mt-2.5 h-28 w-1.5 shrink-0 2xl:mt-4 2xl:h-36 rounded-full bg-gradient-to-b from-[#E31E24] to-[#8f1116]">
          <!-- Single-line-diagram feed: a trace runs in from the screen edge
               and terminates at the breaker-tick, filling the wide-screen gutter. -->
          <span class="hero-trace" aria-hidden="true">
            <span class="hero-trace-pulse"></span>
            <span class="hero-trace-node hero-trace-node--near"></span>
            <span class="hero-trace-node hero-trace-node--far"></span>
          </span>
          <span class="hero-tick-dot absolute -left-1 -top-2 h-3.5 w-3.5 rounded-full bg-[#E31E24] shadow-[0_0_12px_rgba(227,30,36,0.7)]"></span>
        </div>
        <h1 class="font-headline max-w-lg text-4xl font-black leading-[1.06] tracking-tight text-white sm:text-5xl lg:text-[3.25rem] 2xl:max-w-2xl 2xl:text-[4.25rem]">
          Powering the Maldives with Precision &amp; Expertise
        </h1>
      </div>

      <p class="ml-7 mt-6 max-w-md text-base leading-relaxed text-white/60 md:text-lg 2xl:max-w-xl 2xl:text-xl">
        End-to-end electrical solutions — panel boards, CCTV, lightning protection, and more.
        Serving every island of the Republic.
      </p>

      <div class="ml-7 mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/projects" class="btn btn-primary shadow-lg">
          View Our Projects
        </a>
        <a
          href="/contact"
          class="btn btn-outline border-white/25 text-white hover:border-white hover:bg-white hover:text-[#1a1a1a]"
        >
          Get in Touch
        </a>
      </div>

      <!-- Hero stats as panel instruments that "power on" once the circuit
           pulse reaches the breaker-tick. -->
      <div class="ml-7 mt-12" data-hero-stats>

        <!-- Mounting plate: same finish and corner screws as the nameplate,
             holding three meter modules. -->
        <div
          class="relative w-full max-w-md rounded-md border border-white/15 bg-gradient-to-b from-[#333333] to-[#1c1c1c] p-3 shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_3px_8px_rgba(0,0,0,0.4)] 2xl:max-w-lg"
        >
          <span class="absolute left-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]" aria-hidden="true"></span>
          <span class="absolute right-1 top-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]" aria-hidden="true"></span>
          <span class="absolute bottom-1 left-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]" aria-hidden="true"></span>
          <span class="absolute bottom-1 right-1 h-1 w-1 rounded-full bg-black shadow-[0_1px_0_rgba(255,255,255,0.18)]" aria-hidden="true"></span>
          <dl class="grid grid-cols-3 gap-2.5">
            {stats.map((stat) => (
              <div class="meter flex flex-col gap-2">
                <dt class="order-2 flex items-start gap-1.5 text-[10px] font-semibold uppercase leading-tight tracking-wider text-white/60">
                  <span class="stat-led mt-[3px] h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
                  {stat.label}
                </dt>
                <dd class="order-1">
                  <span class="sr-only">{stat.number}</span>
                  <span class="meter-window relative flex justify-end overflow-hidden rounded-[3px] bg-[#0a0a0a] px-2 py-2 shadow-[inset_0_1px_4px_rgba(0,0,0,0.9),0_0_0_1px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.07)]" aria-hidden="true">
                    <SegmentDisplay value={stat.value} suffix={stat.suffix} class="h-5 sm:h-7 2xl:h-8" />
                  </span>
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- Runs during parsing, before first paint: unless reduced motion is
             on, puts the instruments in their "off" state so the power-on
             animation never flashes final values first. -->
        <script is:inline>
          (() => {
            const root = document.currentScript.parentElement;
            if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.dataset.armed = '';
          })();
        </script>
      </div>

      <script>
        import { gsap } from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        import { DIGIT_SEGMENTS, toDisplayChars } from '../utils/sevenSegment';
        gsap.registerPlugin(ScrollTrigger);

        const LED_ON = { backgroundColor: '#ff3a40', boxShadow: '0 0 8px 2px rgba(255, 58, 64, 0.75)' };
        const LED_OFF = { backgroundColor: '#3b1416', boxShadow: 'none' };

        type DisplayState = number | 'test' | 'blank';

        function setDisplay(svg: SVGSVGElement, state: DisplayState) {
          const cells = Number(svg.dataset.cells);
          const chars =
            state === 'test' ? Array(cells).fill('8')
            : state === 'blank' ? Array(cells).fill(' ')
            : toDisplayChars(state, cells);
          svg.querySelectorAll('[data-digit]').forEach((digit, i) => {
            const lit = DIGIT_SEGMENTS[chars[i]];
            digit.querySelectorAll<SVGElement>('[data-seg]').forEach((seg) => {
              seg.classList.toggle('is-on', lit.includes(seg.dataset.seg!));
            });
          });
          svg.querySelectorAll('[data-plus] .seg').forEach((bar) => bar.classList.toggle('is-on', state !== 'blank'));
        }

        function countUp(
          tl: gsap.core.Timeline, target: number, at: number, duration: number, render: (n: number) => void,
        ) {
          const counter = { val: 0 };
          tl.to(counter, {
            val: target,
            duration,
            ease: 'power2.out',
            onStart: () => render(0),
            onUpdate: () => render(Math.round(counter.val)),
          }, at);
        }

        function powerMeters(root: HTMLElement, delay: number) {
          const meters = root.querySelectorAll<HTMLElement>('.meter');
          // Take over from the CSS armed state: displays dark, lamps off.
          meters.forEach((meter) => {
            setDisplay(meter.querySelector('svg')!, 'blank');
            gsap.set(meter.querySelector('.stat-led'), LED_OFF);
          });
          delete root.dataset.armed;

          const tl = gsap.timeline({ delay });
          meters.forEach((meter, i) => {
            const at = i * 0.3;
            const svg = meter.querySelector('svg')!;
            tl.to(meter.querySelector('.stat-led'), { ...LED_ON, duration: 0.08 }, at);
            // Lamp test, like a real meter on power-up: every segment lit, then dark.
            tl.call(() => setDisplay(svg, 'test'), [], at + 0.1);
            tl.call(() => setDisplay(svg, 'blank'), [], at + 0.45);
            countUp(tl, Number(svg.dataset.targetValue), at + 0.55, 1.1, (n) => setDisplay(svg, n));
          });
        }

        function initHeroStats() {
          const root = document.querySelector<HTMLElement>('[data-hero-stats]');
          if (!root || root.dataset.statsBound === 'true') return;
          root.dataset.statsBound = 'true';
          ScrollTrigger.getById('hero-stats')?.kill();

          if (!('armed' in root.dataset)) return; // reduced motion: static final values

          // On wide screens the circuit pulse runs into the breaker-tick first
          // (CSS, ~1.8s); the instruments power on right as it arrives.
          const initAt = performance.now();
          const trace = document.querySelector('.hero-trace');
          const fedByTrace = !!trace && getComputedStyle(trace).display !== 'none';

          ScrollTrigger.create({
            id: 'hero-stats',
            trigger: root,
            start: 'top 92%',
            once: true,
            onEnter: () => {
              const elapsed = (performance.now() - initAt) / 1000;
              const delay = fedByTrace ? Math.max(0.15, 1.75 - elapsed) : 0.15;
              powerMeters(root, delay);
            },
          });
        }

        initHeroStats();
        document.addEventListener('astro:page-load', initHeroStats);
      </script>
    </div>

    <!-- Image column -->
    <div class="relative hidden min-h-[420px] lg:block">
      <div class="hero-photo absolute inset-0 bg-[#111]">
        <Image
          src={heroBg}
          alt="Multitec Maldives electrical engineering work"
          width={2400}
          quality={90}
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-photo-scrim absolute inset-0"></div>
      </div>

      <!-- Credential badge — compact, anchored to the bottom of the photo -->
      <div class="absolute bottom-10 left-6 flex w-fit items-center gap-3 rounded-xl border border-white/10 bg-[#0f0f0f]/85 p-3.5 backdrop-blur">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 13l4 4l10 -10" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-white">URA-Approved Installations</p>
          <p class="mt-0.5 text-[11px] text-white/50">Drawings approved before energisation</p>
        </div>
      </div>
    </div>

    <!-- Scroll cue — desktop only, where the hero fills the viewport and the
         fold cut isn't obvious. Links to the next section so it's a real
         affordance, not just decoration. -->
    <a
      href="#services-heading"
      class="scroll-bounce absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 text-white/40 transition-colors hover:text-white/70 lg:flex"
      aria-label="Scroll to explore our services"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6l6 -6" />
      </svg>
    </a>
  </section>

  <!-- ── SECTION 2: SERVICES ── -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading
        id="services-heading"
        title="Six disciplines. One accountable team."
        intro="From panel fabrication to final inspection, every stage is handled in-house and documented for URA approval. Select a service to see what the work involves."
      />
      <ServiceExplorer services={services} projects={allProjects} />
      <div class="mt-12">
        <a
          href="/services"
          class="btn btn-outline border-[#1a1a1a] text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white"
        >
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 3: FEATURED PROJECTS ── -->
  <section class="bg-[#FAFAFA] pb-20 pt-12 md:pb-28 md:pt-16" aria-labelledby="projects-heading">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading
        id="projects-heading"
        title="Project Highlights"
        intro="A snapshot of recent work, from metering panels in Malé to full resort fit-outs in the southern atolls."
      />

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {highlightProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <div class="mt-12" data-animate>
        <a
          href="/projects"
          class="btn btn-outline border-[#1a1a1a] text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white"
        >
          View All Projects
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 3b: PROJECT MAP ── -->
  <section class="bg-[#0f1418] py-20 md:py-28" aria-labelledby="map-heading">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading
        id="map-heading"
        tone="dark"
        title="Wired across the atolls."
        intro="Every project is wired back to our office in Malé. Select one to see where it is and what we did."
      />
      <ProjectMap projects={allProjects} />
    </div>
  </section>

  <!-- ── SECTION 4: WHY CHOOSE US ── -->
  <section class="bg-[#F5F5F5] pb-20 pt-12 md:pb-28 md:pt-16" aria-labelledby="why-heading">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading
        id="why-heading"
        title="Why clients choose Multitec"
        intro="We've built our reputation on technical excellence, reliability, and a deep understanding of what it takes to deliver in island conditions."
      />

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {whyUs.map((point, i) => {
          const isLast = i === whyUs.length - 1;
          return (
            <article
              class={`flex flex-col rounded-2xl p-7 ${isLast ? 'bg-[#1a1a1a]' : 'border border-black/5 bg-white'}`}
              data-animate
            >
              <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${isLast ? 'bg-[#E31E24]/15' : 'bg-[#E31E24]/10'} text-[#E31E24]`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={point.icon}
                />
              </div>
              <h3 class={`font-display mt-5 text-base font-semibold ${isLast ? 'text-white' : 'text-[#1a1a1a]'}`}>{point.title}</h3>
              <p class={`mt-2 text-sm leading-relaxed ${isLast ? 'text-white/50' : 'text-[#4a4a4a]'}`}>{point.description}</p>
              {isLast && (
                <a href="/contact" class="mt-5 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-[#E31E24] hover:underline">
                  Get in Touch
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" />
                  </svg>
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── SECTION 5: CTA BANNER ── -->
  <CtaBanner
    heading="Ready to Start Your Project?"
    subtext="Talk to our engineers about your electrical requirements — whether it's a single installation or a large-scale fitout."
    buttonText="Get in Touch"
    buttonLink="/contact"
  />

</BaseLayout>

<style>
  /* Desktop hero: the photo bleeds left and fades into the dark side, and a
     circuit trace feeds the breaker-tick from the screen edge. Mobile hides
     the photo column and trace entirely. */
  .hero-trace {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-photo {
      left: -14vw;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 45%);
      mask-image: linear-gradient(to right, transparent 0%, #000 45%);
    }
    .hero-photo-scrim {
      background: linear-gradient(to right, rgb(26 26 26 / 0.5), rgb(26 26 26 / 0) 55%);
    }
  }

  /* Trace spans exactly from the screen edge to the breaker-tick: its width
     is the same frame gutter as the text column's left padding. Below 1280px that gutter is too
     narrow to read as a line, so it's only shown from there up. */
  @media (min-width: 1280px) {
    .hero-trace {
      display: block;
      position: absolute;
      right: 100%;
      top: -2px;
      width: var(--spacing-frame);
      height: 2px;
      background: linear-gradient(to right, rgb(227 30 36 / 0.3), rgb(227 30 36 / 0.9));
    }
  }

  .hero-trace-node {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    border: 1.5px solid #e31e24;
    border-radius: 9999px;
    background: #1a1a1a;
    transform: translate(50%, -50%);
  }
  .hero-trace-node--near {
    right: 30%;
  }
  .hero-trace-node--far {
    right: 70%;
  }

  .hero-trace-pulse {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent calc(100% - 7rem),
      #ff8a8d calc(100% - 0.75rem),
      transparent 100%
    );
    filter: drop-shadow(0 0 4px rgb(255 80 85 / 0.9));
    transform: translateX(-100%);
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-trace-pulse {
      animation: hero-trace-pulse 1.3s cubic-bezier(0.55, 0, 0.35, 1) 0.5s forwards;
    }
    .hero-tick-dot {
      animation: hero-tick-flare 0.7s ease-out 1.7s;
    }
  }

  @keyframes hero-trace-pulse {
    0% { transform: translateX(-100%); opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateX(0); opacity: 0; }
  }

  @keyframes hero-tick-flare {
    35% {
      transform: scale(1.3);
      box-shadow: 0 0 26px 6px rgb(227 30 36 / 0.95);
    }
  }

  /* ── Hero stats instruments ── */
  /* Faint glass reflection across the top of each meter window. */
  .meter-window::after {
    content: '';
    position: absolute;
    inset: 0 0 50% 0;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.06), transparent);
    pointer-events: none;
  }

  /* Status lamps are lit at rest; the armed (pre-animation) state turns them
     off until GSAP powers them on, with a 4s failsafe if it never runs. */
  .stat-led {
    background: #ff3a40;
    box-shadow: 0 0 8px 2px rgb(255 58 64 / 0.75);
  }
  [data-armed] .stat-led {
    background: #3b1416;
    box-shadow: none;
    animation: stats-lamp-failsafe 0s 4s forwards;
  }
  @keyframes stats-lamp-failsafe {
    to {
      background: #ff3a40;
      box-shadow: 0 0 8px 2px rgb(255 58 64 / 0.75);
    }
  }
</style>
