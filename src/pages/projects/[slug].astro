---
import { sanityClient } from 'sanity:client';
import { defineQuery } from 'groq';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Project } from '../../types';
import { sanityImageUrl } from '../../utils/sanityImage';

const PROJECT_QUERY = defineQuery(
  `*[_type == "project" && slug.current == $slug][0] {
    _id, title, "slug": slug.current, description, category,
    client, location, year, completionDate,
    coverImage,
    images,
    featured, body
  }`
);

export async function getStaticPaths() {
  const SLUGS_QUERY = defineQuery(
    `*[_type == "project" && defined(slug.current)] { "params": { "slug": slug.current } }`
  );
  return await sanityClient.fetch(SLUGS_QUERY);
}

const { slug } = Astro.params;
const project = await sanityClient.fetch(PROJECT_QUERY, { slug }) as Project | null;
const coverImageUrl = project?.coverImage ? sanityImageUrl(project.coverImage, 900) : undefined;
// Two sizes per gallery photo: small for the grid thumbnail, larger for the
// lightbox's full-size view (still far short of the raw Sanity original,
// which was seen as large as 4000px wide).
const galleryThumbUrls = (project?.images ?? []).map((img) => sanityImageUrl(img, 700));
const galleryFullUrls = (project?.images ?? []).map((img) => sanityImageUrl(img, 1400, 82));
const categories = Array.isArray(project?.category)
  ? project.category
  : project?.category
    ? [project.category]
    : [];
---

<BaseLayout title={project?.title ?? 'Project'} description={project?.description ?? ''}>
  {project ? (
    <article>
      <!-- Project header — two column on large screens -->
      <header class="relative overflow-hidden surface-ink text-white">
        <div class="column relative pb-16 pt-12 md:pb-20 lg:grid lg:grid-cols-2 lg:items-end lg:gap-14">
          <!-- Left: details -->
          <div class="py-4">
            <a href="/projects" class="text-sm text-white/60 transition-colors hover:text-white">&larr; All projects</a>
            <span class="mb-6 mt-10 block h-1 w-16 bg-[#E31E24]" aria-hidden="true"></span>
            <h1 class="font-headline text-[clamp(2.4rem,5vw,4.2rem)] font-extrabold leading-[0.98] tracking-[-0.03em] [text-wrap:balance]">{project.title}</h1>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">{project.description}</p>

            <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-3 [&>div]:border-t [&>div]:border-white/15 [&>div]:pt-3">
              {project.client && (
                <div>
                  <dt class="mb-1 text-xs font-semibold uppercase tracking-wider text-white/55">Client</dt>
                  <dd class="font-medium">{project.client}</dd>
                </div>
              )}
              {project.year && (
                <div>
                  <dt class="mb-1 text-xs font-semibold uppercase tracking-wider text-white/55">Year</dt>
                  <dd class="font-medium">{project.year}</dd>
                </div>
              )}
              {project.location && (
                <div>
                  <dt class="mb-1 text-xs font-semibold uppercase tracking-wider text-white/55">Location</dt>
                  <dd class="font-medium">{project.location}</dd>
                </div>
              )}
              {categories.length > 0 && (
                <div>
                  <dt class="mb-1 text-xs font-semibold uppercase tracking-wider text-white/55">Scope</dt>
                  <dd class="font-medium">{categories.join(' · ')}</dd>
                </div>
              )}
            </dl>
          </div>

          <!-- Right: cover image -->
          {coverImageUrl && (
            <div class="mt-10 lg:mt-0">
              <img
                src={coverImageUrl}
                alt={`${project.title} project photo`}
                class="aspect-[4/3] w-full object-cover opacity-0 transition-opacity duration-500"
                data-fade-image
              />
            </div>
          )}
        </div>
      </header>

      <!-- Gallery -->
      {galleryThumbUrls.length > 0 && (
        <section class="bg-[#f5f6f6] section-y-tight" aria-label="Project gallery">
          <div class="column">
            <div class={`grid gap-4 ${galleryThumbUrls.length === 1 ? 'grid-cols-1 max-w-md mx-auto' : galleryThumbUrls.length === 2 ? 'grid-cols-2' : 'grid-cols-2 lg:grid-cols-3'}`}>
              {galleryThumbUrls.map((img, i) => (
                <button
                  type="button"
                  class="group relative cursor-zoom-in overflow-hidden"
                  data-gallery-trigger
                  data-index={i}
                  aria-label={`View photo ${i + 1} of ${galleryThumbUrls.length} full size`}
                >
                  <img
                    src={img}
                    alt={`${project.title} photo ${i + 1}`}
                    class="aspect-[4/3] w-full object-cover opacity-0 transition-all duration-500 group-hover:scale-105"
                    data-fade-image
                    loading="lazy"
                  />
                </button>
              ))}
            </div>
          </div>

          <!-- Lightbox -->
          <dialog
            id="gallery-lightbox"
            class="gallery-lightbox"
            aria-label={`${project.title} gallery, full size view`}
            data-images={JSON.stringify(galleryFullUrls)}
          >
            <button type="button" class="gallery-lightbox-close" data-gallery-close aria-label="Close">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
              </svg>
            </button>
            {galleryThumbUrls.length > 1 && (
              <>
                <button type="button" class="gallery-lightbox-nav gallery-lightbox-prev" data-gallery-prev aria-label="Previous photo">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 6l-6 6l6 6" />
                  </svg>
                </button>
                <button type="button" class="gallery-lightbox-nav gallery-lightbox-next" data-gallery-next aria-label="Next photo">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 6l6 6l-6 6" />
                  </svg>
                </button>
              </>
            )}
            <img data-gallery-image alt="" />
            {galleryThumbUrls.length > 1 && (
              <p class="gallery-lightbox-counter" data-gallery-counter aria-live="polite"></p>
            )}
          </dialog>

          <style>
            .gallery-lightbox {
              position: fixed;
              inset: 0;
              margin: auto;
              max-width: min(92vw, 1100px);
              max-height: 88vh;
              padding: 0;
              border: none;
              border-radius: 0.75rem;
              background: transparent;
              overflow: visible;
              opacity: 0;
            }

            .gallery-lightbox::backdrop {
              background: rgba(10, 10, 10, 0.88);
              opacity: 0;
            }

            @media (prefers-reduced-motion: no-preference) {
              .gallery-lightbox,
              .gallery-lightbox::backdrop {
                transition: opacity 0.25s ease;
              }
              .gallery-lightbox {
                transition: opacity 0.25s ease, transform 0.25s ease;
                transform: scale(0.96);
              }
            }

            .gallery-lightbox.is-open,
            .gallery-lightbox.is-open::backdrop {
              opacity: 1;
            }

            .gallery-lightbox.is-open {
              transform: scale(1);
            }

            .gallery-lightbox img {
              display: block;
              max-width: 100%;
              max-height: 88vh;
              border-radius: 0.75rem;
              object-fit: contain;
            }

            .gallery-lightbox-close {
              position: fixed;
              top: 1.25rem;
              right: 1.25rem;
              display: flex;
              height: 2.5rem;
              width: 2.5rem;
              align-items: center;
              justify-content: center;
              border-radius: 9999px;
              background: rgba(255, 255, 255, 0.1);
              color: white;
              transition: background-color 0.2s ease;
            }
            .gallery-lightbox-close:hover {
              background: rgba(255, 255, 255, 0.2);
            }

            .gallery-lightbox-nav {
              position: fixed;
              top: 50%;
              display: flex;
              height: 3rem;
              width: 3rem;
              translate: 0 -50%;
              align-items: center;
              justify-content: center;
              border-radius: 9999px;
              background: rgba(255, 255, 255, 0.1);
              color: white;
              transition: background-color 0.2s ease;
            }
            .gallery-lightbox-nav:hover {
              background: rgba(255, 255, 255, 0.2);
            }
            .gallery-lightbox-prev {
              left: 1.25rem;
            }
            .gallery-lightbox-next {
              right: 1.25rem;
            }

            .gallery-lightbox-counter {
              position: fixed;
              bottom: 1.25rem;
              left: 50%;
              translate: -50% 0;
              font-size: 0.8125rem;
              color: rgba(255, 255, 255, 0.7);
            }
          </style>

          <script>
            function initGalleryLightbox() {
              const dialogEl = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
              if (!dialogEl) return;
              if (dialogEl.dataset.lightboxBound === 'true') return;
              dialogEl.dataset.lightboxBound = 'true';
              // Re-bound to a non-nullable alias: TS's narrowing from the
              // guard above doesn't persist into the nested function/event
              // closures below, which all reference this.
              const dialog: HTMLDialogElement = dialogEl;

              const images: string[] = JSON.parse(dialog.dataset.images ?? '[]');
              const imgEl = dialog.querySelector<HTMLImageElement>('[data-gallery-image]');
              const counterEl = dialog.querySelector<HTMLElement>('[data-gallery-counter]');
              const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-gallery-close]');
              const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-gallery-prev]');
              const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-gallery-next]');
              const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-trigger]'));

              let currentIndex = 0;
              let closeTimer: number | undefined;

              function render() {
                if (!imgEl || !images[currentIndex]) return;
                imgEl.src = images[currentIndex];
                imgEl.alt = `Gallery photo ${currentIndex + 1} of ${images.length}`;
                if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${images.length}`;
              }

              function open(index: number) {
                currentIndex = index;
                render();
                window.clearTimeout(closeTimer);
                dialog.classList.remove('is-open');
                dialog.showModal();
                document.documentElement.classList.add('overflow-hidden');
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => dialog.classList.add('is-open'));
                });
              }

              function requestClose() {
                dialog.classList.remove('is-open');
                document.documentElement.classList.remove('overflow-hidden');
                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (prefersReducedMotion) {
                  dialog.close();
                  return;
                }
                closeTimer = window.setTimeout(() => dialog.close(), 250);
              }

              function next() {
                currentIndex = (currentIndex + 1) % images.length;
                render();
              }

              function prev() {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                render();
              }

              triggers.forEach((trigger) => {
                trigger.addEventListener('click', () => open(Number(trigger.dataset.index)));
              });

              closeBtn?.addEventListener('click', requestClose);
              nextBtn?.addEventListener('click', next);
              prevBtn?.addEventListener('click', prev);

              dialog.addEventListener('cancel', (e) => {
                e.preventDefault();
                requestClose();
              });

              dialog.addEventListener('click', (e) => {
                if (e.target === dialog) requestClose();
              });

              dialog.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowRight') next();
                if (e.key === 'ArrowLeft') prev();
              });
            }

            initGalleryLightbox();
            document.addEventListener('astro:page-load', initGalleryLightbox);
          </script>
        </section>
      )}

      <!-- Project body -->
      <section class="section-y" aria-labelledby="project-detail-heading">
        <div class="column">
          <div class="max-w-3xl">
          <h2 id="project-detail-heading" class="sr-only">Project details</h2>
          {project.body ? (
            <div class="prose prose-base" set:html={project.body} />
          ) : (
            <p class="py-10 text-[#4a4a4a]/80">Full project details coming soon.</p>
          )}
          </div>
        </div>
      </section>

      <!-- Navigation -->
      <nav class="border-t border-[#d3d7da] section-y-tight" aria-label="Project navigation">
        <div class="column flex flex-wrap items-center justify-between gap-6">
          <a href="/projects" class="link-underline text-[#1a1a1a]">&larr; All projects</a>
          <a href={`/contact?type=consultation&project=${project.slug}`} class="button-sweep">Discuss a similar project</a>
        </div>
      </nav>
    </article>

    <script>
      // Cover photo and gallery thumbnails fade in on load instead of
      // popping in abruptly — guarded per-image (not a single page-level
      // flag) since there can be many of these on one page.
      function initImageFadeIn() {
        const images = document.querySelectorAll<HTMLImageElement>('[data-fade-image]');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        images.forEach((img) => {
          if (img.dataset.fadeBound === 'true') return;
          img.dataset.fadeBound = 'true';

          if (prefersReducedMotion || img.complete) {
            img.classList.remove('opacity-0');
            return;
          }

          const reveal = () => img.classList.remove('opacity-0');
          img.addEventListener('load', reveal, { once: true });
          img.addEventListener('error', reveal, { once: true });
        });
      }

      initImageFadeIn();
      document.addEventListener('astro:page-load', initImageFadeIn);
    </script>
  ) : (
    <section class="flex min-h-[70vh] items-center justify-center px-4">
      <div class="text-center">
        <h1 class="font-display text-4xl font-bold text-[#1a1a1a]">Project Not Found</h1>
        <p class="mt-4 text-[#4a4a4a]"><a href="/projects" class="text-[#E31E24] hover:underline">Back to all projects</a></p>
      </div>
    </section>
  )}
</BaseLayout>
