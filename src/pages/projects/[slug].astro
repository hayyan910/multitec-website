---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../types';

export const getStaticPaths = (async () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.description}>
  <article>
    <!-- Project header -->
    <header class="bg-neutral py-20 text-neutral-content">
      <div class="container mx-auto max-w-3xl px-4">
        <a
          href="/projects"
          class="mb-6 inline-block text-sm text-neutral-content/50 transition-colors hover:text-primary"
        >
          &larr; All Projects
        </a>
        <span class="badge badge-primary mb-4 block w-fit">{project.category}</span>
        <h1 class="mb-4 text-3xl font-bold md:text-4xl">{project.title}</h1>
        <p class="text-lg text-neutral-content/70">{project.description}</p>

        <dl class="mt-8 flex flex-wrap gap-8">
          {
            project.client && (
              <div>
                <dt class="mb-1 text-xs uppercase tracking-wider text-neutral-content/50">
                  Client
                </dt>
                <dd class="font-medium">{project.client}</dd>
              </div>
            )
          }
          <div>
            <dt class="mb-1 text-xs uppercase tracking-wider text-neutral-content/50">Year</dt>
            <dd class="font-medium">{project.year}</dd>
          </div>
          <div>
            <dt class="mb-1 text-xs uppercase tracking-wider text-neutral-content/50">Sector</dt>
            <dd class="font-medium">{project.category}</dd>
          </div>
        </dl>
      </div>
    </header>

    <!-- Project body -->
    <section class="py-16" aria-labelledby="project-detail-heading">
      <div class="container mx-auto max-w-3xl px-4">
        <h2 id="project-detail-heading" class="sr-only">Project details</h2>
        {
          project.body ? (
            <div class="prose prose-base" set:html={project.body} />
          ) : (
            <p class="py-10 text-center text-base-content/50">
              Full project details coming soon.
            </p>
          )
        }
      </div>
    </section>

    <!-- Back / next actions -->
    <nav class="border-t border-base-300 py-10" aria-label="Project navigation">
      <div class="container mx-auto max-w-3xl px-4 flex justify-between">
        <a href="/projects" class="btn btn-outline btn-primary btn-sm">&larr; All Projects</a>
        <a href="/contact" class="btn btn-primary btn-sm">Discuss a Similar Project</a>
      </div>
    </nav>
  </article>
</BaseLayout>
