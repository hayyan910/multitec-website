---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist or may have moved.">
  <section class="relative flex min-h-[70vh] items-center overflow-hidden bg-[#1a1a1a]">
    <!-- Ambient circuit-trace texture — matches the site's hero vocabulary -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.06]" aria-hidden="true">
      <defs>
        <pattern id="not-found-circuit" width="130" height="130" patternUnits="userSpaceOnUse">
          <path d="M0 65 H45 V25 H100" stroke="white" stroke-width="1" fill="none" />
          <path d="M130 100 H85 V125" stroke="white" stroke-width="1" fill="none" />
          <path d="M65 0 V40 H130" stroke="white" stroke-width="1" fill="none" />
          <circle cx="45" cy="25" r="2.5" fill="white" />
          <circle cx="100" cy="25" r="2.5" fill="white" />
          <circle cx="85" cy="125" r="2.5" fill="white" />
          <circle cx="65" cy="40" r="2.5" fill="white" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#not-found-circuit)" />
    </svg>

    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(227,30,36,0.18)_0%,transparent_65%)]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto w-full max-w-3xl px-6 py-20 text-center">
      <div class="flex items-center justify-center gap-5">
        <span class="h-16 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#E31E24] to-[#8f1116]" aria-hidden="true"></span>
        <span class="font-display text-7xl font-black text-white md:text-8xl">404</span>
      </div>

      <h1 class="font-display mt-8 text-3xl font-bold text-white md:text-4xl">
        This page doesn't exist
      </h1>
      <p class="mx-auto mt-4 max-w-md text-base text-white/65 md:text-lg">
        The page you're looking for may have been moved or the link is broken. Let's get you back on track.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn btn-primary shadow-lg">
          Back to Home
        </a>
        <a
          href="/projects"
          class="btn btn-outline border-white/25 text-white hover:border-white hover:bg-white hover:text-[#1a1a1a]"
        >
          View Our Projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
