---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Multitec Maldives for electrical engineering enquiries, quotations, and project consultations across the Maldives."
>
  <PageHero
    title="Get in Touch"
    subtitle="Have a project in mind or need a consultation? We'd love to hear from you."
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
  />

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <!-- Contact info -->
        <div class="flex flex-col gap-8">
          <div>
            <h2 class="text-xl font-bold text-[#1a1a1a]">Contact Information</h2>
            <p class="mt-2 text-sm leading-relaxed text-[#4a4a4a]">
              Reach us directly or fill in the form and we'll get back to you within one business day.
            </p>
          </div>

          <ul class="flex flex-col gap-6 list-none">
            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#E31E24]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 11m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"/></svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-[#1a1a1a]">Address</p>
                <p class="mt-0.5 text-sm text-[#4a4a4a]">H. Coral Hill, Kurangi Goalhi, Malé, Republic of Maldives</p>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#E31E24]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/></svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-[#1a1a1a]">Phone</p>
                <a href="tel:+9603332636" class="mt-0.5 text-sm text-[#4a4a4a] hover:text-[#E31E24] transition-colors">+960 333 2636</a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#E31E24]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/></svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-[#1a1a1a]">Email</p>
                <a href="mailto:info@multitec.com.mv" class="mt-0.5 text-sm text-[#4a4a4a] hover:text-[#E31E24] transition-colors">info@multitec.com.mv</a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#E31E24]/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#E31E24]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54 .54l3 -3a5 5 0 0 0 -7.07 -7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0 -7.54 -.54l-3 3a5 5 0 0 0 7.07 7.07l1.71 -1.71"/></svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-[#1a1a1a]">Website</p>
                <a href="https://multitec.com.mv" class="mt-0.5 text-sm text-[#4a4a4a] hover:text-[#E31E24] transition-colors">multitec.com.mv</a>
              </div>
            </li>
          </ul>

          <div class="rounded-xl bg-[#1a1a1a] p-6 text-white">
            <p class="text-sm font-semibold">Business Hours</p>
            <ul class="mt-3 flex flex-col gap-1.5 list-none text-sm text-white/70">
              <li class="flex justify-between"><span>Sunday – Thursday</span><span>8:00 AM – 5:00 PM</span></li>
              <li class="flex justify-between"><span>Friday – Saturday</span><span>Closed</span></li>
            </ul>
          </div>
        </div>

        <!-- Form -->
        <div class="rounded-2xl border border-base-200 bg-white p-8 shadow-sm">
          <h2 class="text-xl font-bold text-[#1a1a1a]">Send a Message</h2>
          <p class="mt-1 text-sm text-[#4a4a4a]">We typically respond within one business day.</p>

          <form id="contact-form" class="mt-8 flex flex-col gap-5" novalidate>
            <input type="hidden" name="access_key" value="d4b438d6-1335-435d-bf78-33fcacb33680" />
            <input type="hidden" name="subject" value="New enquiry via multitec.mv" />
            <input type="hidden" name="from_name" value="Multitec Website" />
            <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" />

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label for="name" class="text-sm font-medium text-[#1a1a1a]">Full Name <span class="text-[#E31E24]">*</span></label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Ahmed Mohamed"
                  class="rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm text-[#1a1a1a] placeholder:text-[#4a4a4a]/40 outline-none transition focus:border-[#E31E24] focus:ring-2 focus:ring-[#E31E24]/20"
                />
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="email" class="text-sm font-medium text-[#1a1a1a]">Email Address <span class="text-[#E31E24]">*</span></label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="ahmed@example.mv"
                  class="rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm text-[#1a1a1a] placeholder:text-[#4a4a4a]/40 outline-none transition focus:border-[#E31E24] focus:ring-2 focus:ring-[#E31E24]/20"
                />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label for="phone" class="text-sm font-medium text-[#1a1a1a]">Phone <span class="text-[#4a4a4a]/50 font-normal">(optional)</span></label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="+960 300 0000"
                  class="rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm text-[#1a1a1a] placeholder:text-[#4a4a4a]/40 outline-none transition focus:border-[#E31E24] focus:ring-2 focus:ring-[#E31E24]/20"
                />
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="enquiry" class="text-sm font-medium text-[#1a1a1a]">Enquiry Type <span class="text-[#E31E24]">*</span></label>
                <select
                  id="enquiry"
                  name="enquiry_type"
                  required
                  class="rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm text-[#1a1a1a] outline-none transition focus:border-[#E31E24] focus:ring-2 focus:ring-[#E31E24]/20"
                >
                  <option value="" disabled selected>Select a topic</option>
                  <option value="Quotation Request">Quotation Request</option>
                  <option value="Project Consultation">Project Consultation</option>
                  <option value="Service Request">Service Request</option>
                  <option value="General Enquiry">General Enquiry</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="message" class="text-sm font-medium text-[#1a1a1a]">Message <span class="text-[#E31E24]">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Briefly describe your project or enquiry…"
                class="resize-none rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm text-[#1a1a1a] placeholder:text-[#4a4a4a]/40 outline-none transition focus:border-[#E31E24] focus:ring-2 focus:ring-[#E31E24]/20"
              ></textarea>
            </div>

            <!-- Error message -->
            <p id="form-error" class="hidden text-sm text-[#E31E24]"></p>

            <button
              type="submit"
              id="submit-btn"
              class="btn btn-primary w-full sm:w-auto sm:self-start"
            >
              <span id="btn-text">Send Message</span>
              <svg id="btn-spinner" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
            </button>
          </form>

          <!-- Success state -->
          <div id="form-success" class="hidden flex-col items-center gap-4 py-10 text-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-green-100">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5l10 -10"/></svg>
            </span>
            <div>
              <p class="text-lg font-semibold text-[#1a1a1a]">Message sent!</p>
              <p class="mt-1 text-sm text-[#4a4a4a]">Thank you for reaching out. We'll get back to you within one business day.</p>
            </div>
            <button id="reset-btn" class="btn btn-outline btn-sm mt-2">Send another message</button>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
  const formError = document.getElementById('form-error') as HTMLParagraphElement;
  const formSuccess = document.getElementById('form-success') as HTMLDivElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');
    formError.textContent = '';

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    btnText.textContent = 'Sending…';
    btnSpinner.classList.remove('hidden');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const json = await res.json();

      if (json.success) {
        form.classList.add('hidden');
        formSuccess.classList.remove('hidden');
        formSuccess.classList.add('flex');
      } else {
        throw new Error(json.message ?? 'Submission failed');
      }
    } catch (err) {
      formError.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      formError.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Send Message';
      btnSpinner.classList.add('hidden');
    }
  });

  resetBtn?.addEventListener('click', () => {
    form.reset();
    form.classList.remove('hidden');
    formSuccess.classList.add('hidden');
    formSuccess.classList.remove('flex');
  });
</script>
