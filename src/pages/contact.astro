---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Multitec Maldives for electrical engineering enquiries, quotations, and project consultations."
>
  <!-- Page header -->
  <section class="bg-neutral py-20 text-neutral-content">
    <div class="container mx-auto max-w-3xl px-4 text-center">
      <h1 class="mb-4 text-4xl font-bold md:text-5xl">Get in Touch</h1>
      <p class="text-lg text-neutral-content/70">We'd love to hear about your project.</p>
    </div>
  </section>

  <!-- Form + details -->
  <section class="py-16" aria-labelledby="contact-section-heading">
    <div class="container mx-auto max-w-2xl px-4">
      <h2 id="contact-section-heading" class="sr-only">Contact form and details</h2>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="card border border-base-300 bg-base-100 shadow-sm"
        aria-label="Send us a message"
        novalidate
      >
        <div class="card-body gap-5">
          <!--
            Replace YOUR_WEB3FORMS_ACCESS_KEY with the key from
            https://web3forms.com — it takes ~30 seconds to obtain.
          -->
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="New enquiry from Multitec website" />
          <!-- Honeypot for spam prevention -->
          <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" tabindex="-1" />

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="form-control">
              <label class="label" for="name">
                <span class="label-text font-medium">
                  Full Name <span class="text-error" aria-hidden="true">*</span>
                </span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                class="input input-bordered w-full"
                required
                aria-required="true"
                autocomplete="name"
              />
            </div>

            <div class="form-control">
              <label class="label" for="email">
                <span class="label-text font-medium">
                  Email Address <span class="text-error" aria-hidden="true">*</span>
                </span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                class="input input-bordered w-full"
                required
                aria-required="true"
                autocomplete="email"
              />
            </div>
          </div>

          <div class="form-control">
            <label class="label" for="phone">
              <span class="label-text font-medium">Phone Number</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="input input-bordered w-full"
              autocomplete="tel"
            />
          </div>

          <div class="form-control">
            <label class="label" for="service">
              <span class="label-text font-medium">Service Required</span>
            </label>
            <select id="service" name="service" class="select select-bordered w-full">
              <option value="" disabled selected>Select a service…</option>
              <option>Electrical Installation</option>
              <option>Power Systems Design</option>
              <option>Solar PV &amp; Renewables</option>
              <option>Emergency Power Systems</option>
              <option>Testing &amp; Commissioning</option>
              <option>Planned Preventive Maintenance</option>
              <option>Other</option>
            </select>
          </div>

          <div class="form-control">
            <label class="label" for="message">
              <span class="label-text font-medium">
                Message <span class="text-error" aria-hidden="true">*</span>
              </span>
            </label>
            <textarea
              id="message"
              name="message"
              class="textarea textarea-bordered h-32 w-full resize-none"
              required
              aria-required="true"
              placeholder="Tell us about your project…"
            ></textarea>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn btn-primary w-full sm:w-auto">
              Send Message
            </button>
          </div>
        </div>
      </form>

      <!-- Contact details -->
      <div class="mt-12 grid grid-cols-1 gap-6 text-center sm:grid-cols-3">
        <div>
          <h3 class="mb-1 font-semibold">Address</h3>
          <address class="text-sm not-italic text-base-content/70">
            Malé, Republic of Maldives
          </address>
        </div>
        <div>
          <h3 class="mb-1 font-semibold">Email</h3>
          <a href="mailto:info@multitec.mv" class="text-sm text-primary hover:underline">
            info@multitec.mv
          </a>
        </div>
        <div>
          <h3 class="mb-1 font-semibold">Phone</h3>
          <a href="tel:+9603000000" class="text-sm text-primary hover:underline">
            +960 300 0000
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
