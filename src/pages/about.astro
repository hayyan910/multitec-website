---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<BaseLayout
  title="About"
  description="Learn about Multitec Maldives Pvt. Ltd. — our story, values, and the team behind our electrical engineering expertise."
>
  <section class="flex min-h-[70vh] items-center justify-center px-4">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-[#1a1a1a] md:text-5xl">About Multitec</h1>
      <p class="mt-6 text-lg text-[#4a4a4a]">About page — full design coming soon.</p>
    </div>
  </section>

  <CtaBanner
    heading="Work With Us"
    subtext="Bring us onto your next project and experience the Multitec difference."
    buttonText="Get in Touch"
    buttonLink="/contact"
  />
</BaseLayout>
