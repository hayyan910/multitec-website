---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatsBar from '../components/StatsBar.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureList from '../components/FeatureList.astro';
import heroBg from '../assets/images/hero-bg.jpg';

const values = [
  {
    title: 'Technical excellence',
    description:
      'Every installation is engineered to international standards and approved by the Utility Regulatory Authority (URA) of the Maldives.',
  },
  {
    title: 'Client-first approach',
    description:
      'We work closely with clients from initial consultation through to commissioning and handover, ensuring every requirement is met.',
  },
  {
    title: 'Reliability & safety',
    description:
      'Safety is non-negotiable. All electrical works are designed, installed, and tested to comply with Maldivian regulations and IEC standards.',
  },
];

const compliance = [
  {
    title: 'URA approved',
    description:
      'All electrical drawings, plans, and installations are submitted to and approved by the Utility Regulatory Authority (URA) before energisation or panel changeover.',
  },
  {
    title: 'IEC standards',
    description:
      'Works are designed and executed in accordance with IEC electrical standards, ensuring safety, reliability, and long-term performance.',
  },
];
---

<BaseLayout
  title="About"
  description="Learn about Multitec Maldives Pvt. Ltd. — our story since 2003, our values, and our commitment to licensed, IEC-compliant electrical engineering across the Maldives."
>

  <!-- ── SECTION 1: PAGE HERO ── -->
  <PageHero
    title="About Multitec Maldives"
    subtitle="Our story, our principles, and the standards behind every installation"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  />

  <!-- ── SECTION 2: COMPANY STORY ── -->
  <section class="bg-white section-y" aria-labelledby="story-heading">
    <div class="frame">
      <SectionHeading id="story-heading" title="Two decades of powering the Maldives." />
      <div class="grid gap-12 md:grid-cols-2 md:items-start">

        <!-- Text column -->
        <div data-animate>
          <div class="space-y-4 text-base leading-relaxed text-[#4a4a4a]">
            <p>
              Multitec Maldives Pvt. Ltd. was founded in 2003 with a clear mission: to deliver
              reliable, high-quality electrical engineering solutions to the growing infrastructure
              needs of the Maldives. What began as a small operation serving residential clients in
              Malé has grown into one of the country's most trusted names in mechanical and
              electrical works.
            </p>
            <p>
              Over the past 23 years, we have completed more than 200 projects across the Republic
              — from panel board installations in high-rise residential towers to island-wide
              lightning protection systems for remote resorts. Our team of experienced engineers and
              technicians brings technical precision to every project, whether it's a single-phase
              residential fitout or a large-scale commercial installation.
            </p>
            <p>
              At Multitec, we believe that good engineering is about more than just completing a
              job. It's about building systems that last, delivering work that meets international
              standards, and standing behind everything we install. That commitment has earned us
              the trust of clients across the Maldives — and it drives everything we do.
            </p>
          </div>
        </div>

        <!-- Image column -->
        <div class="overflow-hidden" data-animate>
          <Image
            src={heroBg}
            alt="Multitec Maldives electrical engineering work"
            width={1200}
            quality={85}
            data-story-image
            class="h-full min-h-72 w-full object-cover"
          />
        </div>

      </div>
    </div>
  </section>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    function initStoryImageReveal() {
      const image = document.querySelector<HTMLImageElement>('[data-story-image]');
      if (!image) return;
      // astro:page-load also fires on the initial page load (not just
      // client-side navigations), and this function is also called directly
      // below — without this guard, two competing scroll-scrubbed tweens
      // would both drive the same element's scale.
      if (image.dataset.storyRevealBound === 'true') return;
      image.dataset.storyRevealBound = 'true';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return; // static markup already shows the resting scale

      // Scroll-scrubbed, not a one-shot reveal: the image holds a visible
      // zoom at page load and gradually settles to its true scale as the
      // page scrolls, tied directly to scroll position (scrub) so there's
      // no snap/jump — it just tracks the scroll. Starts at the top of the
      // page (scrollY 0) rather than the image's own viewport entry — on
      // this page the image already sits well inside the viewport at
      // scrollY 0 (the hero above it is short), so an entry-relative start
      // like 'top bottom' would already be partway through its range before
      // the page even loads. The end point IS tied to the image's own
      // position though: computed (as a function, so it re-measures on
      // resize) so the zoom finishes exactly when the image's vertical
      // center reaches the viewport's center — not a fixed scroll distance
      // that could complete while the image has already scrolled out of view.
      gsap.set(image, { scale: 1.08 });
      gsap.to(image, {
        scale: 1,
        ease: 'none',
        scrollTrigger: {
          id: 'story-image',
          start: 0,
          end: () => {
            const rect = image.getBoundingClientRect();
            const imageCenterDocY = rect.top + window.scrollY + rect.height / 2;
            return imageCenterDocY - window.innerHeight / 2;
          },
          scrub: 0.6,
        },
      });
    }

    initStoryImageReveal();
    document.addEventListener('astro:page-load', initStoryImageReveal);
  </script>

  <!-- ── SECTION 3: STATS BAR ── -->
  <StatsBar />

  <!-- ── SECTION 4: VALUES ── -->
  <section class="bg-[#f5f6f6] section-y" aria-labelledby="values-heading">
    <div class="frame">
      <SectionHeading id="values-heading" title="What drives us." />
      <FeatureList items={values} />
    </div>
  </section>

  <!-- ── SECTION 5: REGULATORY COMPLIANCE ── -->
  <section class="bg-white section-y" aria-labelledby="compliance-heading">
    <div class="frame">
      <SectionHeading
        id="compliance-heading"
        title="Licensed and compliant."
        intro="All electrical works completed by Multitec Maldives are carried out in full compliance with Maldivian regulatory requirements."
      />
      <FeatureList items={compliance} columns={2} />
      <p class="mt-10 text-sm text-[#5f6469]">Certificates and documentation available on request.</p>
    </div>
  </section>

  <!-- ── SECTION 6: CTA BANNER ── -->
  <CtaBanner
    heading="Work with a team you can trust."
    subtext="With 23 years of experience and full regulatory compliance, Multitec Maldives is ready to deliver your next project."
    buttonText="Get in Touch"
    buttonLink="/contact"
  />

</BaseLayout>
