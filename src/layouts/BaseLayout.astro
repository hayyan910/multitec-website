---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Multitec Maldives Pvt. Ltd. — professional electrical engineering services in Malé, Maldives.',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const { pathname } = Astro.url;

const navLinks = [
  { href: '/',         label: 'Home' },
  { href: '/about',    label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact',  label: 'Contact' },
];
---

<!doctype html>
<html lang="en" data-theme="multitec">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title} | Multitec Maldives</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | Multitec Maldives`} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(ogImage, Astro.site ?? Astro.url)} />
    <meta property="og:locale"      content="en_MV" />
    <meta property="og:site_name"   content="Multitec Maldives" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} | Multitec Maldives`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL(ogImage, Astro.site ?? Astro.url)} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Inter from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>

  <body class="bg-[#FAFAFA] text-[#4a4a4a] antialiased">
    <!-- Skip-to-content (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded focus:bg-[#E31E24] focus:px-4 focus:py-2 focus:text-white focus:outline-none"
    >
      Skip to main content
    </a>

    <!--
      DaisyUI drawer-end: side panel slides in from the right.
      The <label for="mobile-nav-drawer"> toggle lives in Header.astro.
    -->
    <div class="drawer drawer-end">
      <input id="mobile-nav-drawer" type="checkbox" class="drawer-toggle" />

      <!-- ── Page shell ── -->
      <div class="drawer-content flex min-h-screen flex-col">
        <Header />
        <main id="main-content" class="flex-1" tabindex="-1">
          <slot />
        </main>
        <Footer />
      </div>

      <!-- ── Mobile side drawer ── -->
      <div class="drawer-side z-[200]">
        <label
          for="mobile-nav-drawer"
          aria-label="Close navigation menu"
          class="drawer-overlay"
        ></label>

        <nav
          class="flex min-h-screen w-72 flex-col bg-[#1a1a1a] px-6 py-8"
          aria-label="Mobile navigation"
        >
          <!-- Logo -->
          <a href="/" class="mb-10 block">
            <img
              src="/images/company/multitec-logo-white.svg"
              alt="Multitec Maldives"
              width="160"
              height="48"
              class="h-12 w-auto"
            />
          </a>

          <!-- Links -->
          <ul class="flex flex-col gap-1 list-none" role="list">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class={[
                    'block rounded px-3 py-3 text-sm font-medium transition-colors duration-200',
                    pathname === href
                      ? 'text-[#E31E24]'
                      : 'text-white/70 hover:text-white',
                  ].join(' ')}
                  aria-current={pathname === href ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-8">
            <a href="/contact" class="btn btn-primary w-full">Get in Touch</a>
          </div>
        </nav>
      </div>
    </div>
    <script>
      function observeAnimations() {
        const els = document.querySelectorAll<HTMLElement>('[data-animate]:not(.in-view)');
        if (!els.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        els.forEach((el) => observer.observe(el));
      }

      observeAnimations();
      document.addEventListener('astro:page-load', observeAnimations);
    </script>
  </body>
</html>
