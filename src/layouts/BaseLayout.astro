---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Multitec Maldives Pvt. Ltd. — professional electrical engineering services in Malé, Maldives.',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const { pathname } = Astro.url;

const navLinks = [
  { href: '/',         label: 'Home' },
  { href: '/about',    label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact',  label: 'Contact' },
];
---

<!doctype html>
<html lang="en" data-theme="multitec">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title} | Multitec Maldives</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | Multitec Maldives`} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(ogImage, Astro.site ?? Astro.url)} />
    <meta property="og:locale"      content="en_MV" />
    <meta property="og:site_name"   content="Multitec Maldives" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} | Multitec Maldives`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL(ogImage, Astro.site ?? Astro.url)} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Inter from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>

  <body class="bg-[#FAFAFA] text-[#4a4a4a] antialiased">
    <!-- Skip-to-content (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded focus:bg-[#E31E24] focus:px-4 focus:py-2 focus:text-white focus:outline-none"
    >
      Skip to main content
    </a>

    <!--
      DaisyUI drawer-end: side panel slides in from the right.
      The <label for="mobile-nav-drawer"> toggle lives in Header.astro.
    -->
    <div class="drawer drawer-end">
      <input id="mobile-nav-drawer" type="checkbox" class="drawer-toggle" />

      <!-- ── Page shell ── -->
      <div class="drawer-content flex min-h-screen flex-col">
        <Header />
        <main id="main-content" class="flex-1" tabindex="-1">
          <slot />
        </main>
        <Footer />

        <!-- WhatsApp floating button -->
        <a
          href="https://wa.me/9607783293"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat with us on WhatsApp"
          class="fixed bottom-6 right-6 z-[150] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition-transform duration-200 hover:scale-110 hover:shadow-xl"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
        </a>
      </div>

      <!-- ── Mobile side drawer ── -->
      <div class="drawer-side z-[200]">
        <label
          for="mobile-nav-drawer"
          aria-label="Close navigation menu"
          class="drawer-overlay"
        ></label>

        <nav
          class="flex min-h-screen w-72 flex-col bg-[#1a1a1a] px-6 py-8"
          aria-label="Mobile navigation"
        >
          <!-- Logo -->
          <a href="/" class="mb-10 block">
            <img
              src="/images/company/multitec-logo-white.svg"
              alt="Multitec Maldives"
              width="160"
              height="48"
              class="h-12 w-auto"
            />
          </a>

          <!-- Links -->
          <ul class="flex flex-col gap-1 list-none" role="list">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class={[
                    'block rounded px-3 py-3 text-sm font-medium transition-colors duration-200',
                    pathname === href
                      ? 'text-[#E31E24]'
                      : 'text-white/70 hover:text-white',
                  ].join(' ')}
                  aria-current={pathname === href ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-8">
            <a href="/contact" class="btn btn-primary w-full">Get in Touch</a>
          </div>
        </nav>
      </div>
    </div>
    <script>
      function observeAnimations() {
        const els = document.querySelectorAll<HTMLElement>('[data-animate]:not(.in-view)');
        if (!els.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        els.forEach((el) => observer.observe(el));
      }

      observeAnimations();
      document.addEventListener('astro:page-load', observeAnimations);
    </script>
  </body>
</html>
