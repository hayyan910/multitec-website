---
// TEMPORARY preview tool: switch the dark shade and surface finish being
// compared (see BaseLayout + global.css). Remove once a choice is made.
const shades = [
  { id: 'black', label: 'Brand black', hex: '#1a1a1a' },
  { id: 'warm', label: 'Warm black', hex: '#1c1a18' },
  { id: 'graphite', label: 'Graphite', hex: '#17191b' },
  { id: 'ink', label: 'Deep ink', hex: '#111111' },
  { id: 'charcoal', label: 'Charcoal', hex: '#232323' },
  { id: 'night', label: 'Blue-grey night', hex: '#0f1a21' },
];
const finishes = [
  { id: 'flat', label: 'Flat' },
  { id: 'matte', label: 'Matte' },
  { id: 'sheen', label: 'Sheen' },
];
---

<details class="variant-panel fixed bottom-4 left-4 z-[60] w-64 rounded-xl bg-white text-[13px] text-[#1a1a1a] shadow-[0_10px_30px_rgba(0,0,0,0.25)] ring-1 ring-black/10" data-variant-panel>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-semibold">
    <span class="flex items-center gap-2">
      <span class="variant-current-swatch h-4 w-4 rounded-full ring-1 ring-black/20" aria-hidden="true"></span>
      Dark colour &amp; finish
    </span>
    <svg class="variant-chevron h-4 w-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6 -6l6 6" /></svg>
  </summary>
  <nav class="grid gap-4 border-t border-black/10 px-4 pb-4 pt-3" aria-label="Preview variations">
    <div>
      <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#5f6469]">Shade</p>
      <ul class="grid gap-0.5">
        {shades.map((shade) => (
          <li>
            <a href={`?dark=${shade.id}`} data-key="dark" data-value={shade.id} class="variant-link flex items-center gap-2.5 rounded-md px-2 py-1.5 hover:bg-black/5">
              <span class="h-4 w-4 shrink-0 rounded-full ring-1 ring-black/20" style={`background:${shade.hex}`} aria-hidden="true"></span>
              <span class="flex-1">{shade.label}</span>
              <code class="text-[11px] text-[#5f6469]">{shade.hex}</code>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#5f6469]">Finish</p>
      <ul class="grid grid-cols-3 gap-1">
        {finishes.map((finish) => (
          <li>
            <a href={`?finish=${finish.id}`} data-key="finish" data-value={finish.id} class="variant-link block rounded-md px-2 py-1.5 text-center ring-1 ring-black/10 hover:bg-black/5">{finish.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</details>

<style>
  .variant-panel[open] .variant-chevron { transform: rotate(180deg); }
  .variant-panel summary::-webkit-details-marker { display: none; }
  .variant-link[aria-current='true'] { background: #1a1a1a; color: #fff; }
  .variant-link[aria-current='true'] code { color: rgb(255 255 255 / 0.7); }
  .variant-current-swatch { background: var(--color-night); }
</style>

<script>
  // Mark the active shade and finish; keeps the panel open across page swaps.
  function markVariant() {
    const panel = document.querySelector<HTMLDetailsElement>('[data-variant-panel]');
    if (!panel) return;
    const { dark, finish } = document.documentElement.dataset;
    panel.querySelectorAll<HTMLAnchorElement>('.variant-link').forEach((link) => {
      const active = (link.dataset.key === 'dark' ? dark : finish) === link.dataset.value;
      link.setAttribute('aria-current', String(active));
    });
    try {
      panel.open = sessionStorage.getItem('variant-panel-open') === 'true';
    } catch {}
    if (!panel.dataset.bound) {
      panel.dataset.bound = 'true';
      panel.addEventListener('toggle', () => {
        try { sessionStorage.setItem('variant-panel-open', String(panel.open)); } catch {}
      });
    }
  }

  markVariant();
  document.addEventListener('astro:page-load', markVariant);
</script>
