---
const year = new Date().getFullYear();
---

<footer class="bg-[#1a1a1a] text-white" role="contentinfo">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">

      <!-- Column 1: Brand -->
      <div>
        <a href="/" aria-label="Multitec Maldives — home" class="inline-block mb-4">
          <img
            src="/images/company/multitec-logo-white.svg"
            alt="Multitec Maldives"
            width="160"
            height="48"
            class="h-12 w-auto"
          />
        </a>
        <p class="mb-3 text-sm italic text-white/50">
          ...expand your vision.
        </p>
        <p class="text-sm leading-relaxed text-white/60">
          Professional electrical engineering services based in Malé, Republic of Maldives.
        </p>
      </div>

      <!-- Column 2: Quick links -->
      <nav aria-label="Footer navigation">
        <h2 class="mb-5 text-xs font-semibold uppercase tracking-widest text-white/40">
          Quick Links
        </h2>
        <ul class="flex flex-col gap-3 list-none text-sm" role="list">
          <li><a href="/"         class="text-white/70 transition-colors duration-200 hover:text-[#E31E24]">Home</a></li>
          <li><a href="/about"    class="text-white/70 transition-colors duration-200 hover:text-[#E31E24]">About</a></li>
          <li><a href="/services" class="text-white/70 transition-colors duration-200 hover:text-[#E31E24]">Services</a></li>
          <li><a href="/projects" class="text-white/70 transition-colors duration-200 hover:text-[#E31E24]">Projects</a></li>
          <li><a href="/contact"  class="text-white/70 transition-colors duration-200 hover:text-[#E31E24]">Contact</a></li>
        </ul>
      </nav>

      <!-- Column 3: Contact -->
      <div>
        <h2 class="mb-5 text-xs font-semibold uppercase tracking-widest text-white/40">
          Contact
        </h2>
        <address class="flex flex-col gap-4 text-sm not-italic">

          <div class="flex items-start gap-3 text-white/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-[#E31E24]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742z" clip-rule="evenodd" />
            </svg>
            <span>H. Coral Hill, Kurangi Goalhi,<br />Malé 20026, Republic of Maldives</span>
          </div>

          <a href="tel:+9603332636" class="flex items-center gap-3 text-white/70 transition-colors duration-200 hover:text-[#E31E24]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#E31E24]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd" />
            </svg>
            <span>+960 333 2636</span>
          </a>

          <a href="mailto:info@multitec.com.mv" class="flex items-center gap-3 text-white/70 transition-colors duration-200 hover:text-[#E31E24]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#E31E24]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z" />
              <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z" />
            </svg>
            <span>info@multitec.com.mv</span>
          </a>

          <a href="https://wa.me/9607783293" class="flex items-center gap-3 text-white/70 transition-colors duration-200 hover:text-[#E31E24]" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#E31E24]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>+960 778 3293</span>
          </a>
        </address>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-5 text-center text-xs text-white/40">
      <p>&copy; {year} Multitec Maldives Pvt. Ltd. All rights reserved.</p>
    </div>
  </div>
</footer>
