---
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">

      <!-- Brand -->
      <div>
        <p class="mb-3 text-xl font-bold">
          <span class="text-primary">Multitec</span> Maldives
        </p>
        <p class="text-sm leading-relaxed text-neutral-content/70">
          Professional electrical engineering services in Malé, Maldives. Delivering safe,
          efficient, and sustainable solutions since day one.
        </p>
      </div>

      <!-- Quick links -->
      <nav aria-label="Footer navigation">
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-neutral-content/50">
          Quick Links
        </h2>
        <ul class="flex flex-col gap-2 list-none text-sm" role="list">
          <li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
          <li><a href="/about" class="transition-colors hover:text-primary">About</a></li>
          <li><a href="/services" class="transition-colors hover:text-primary">Services</a></li>
          <li><a href="/projects" class="transition-colors hover:text-primary">Projects</a></li>
          <li><a href="/contact" class="transition-colors hover:text-primary">Contact</a></li>
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-neutral-content/50">
          Contact
        </h2>
        <address class="flex flex-col gap-2 text-sm not-italic text-neutral-content/70">
          <span>Malé, Republic of Maldives</span>
          <a href="mailto:info@multitec.mv" class="transition-colors hover:text-primary">
            info@multitec.mv
          </a>
          <a href="tel:+9603000000" class="transition-colors hover:text-primary">
            +960 300 0000
          </a>
        </address>
      </div>
    </div>

    <div class="mt-10 border-t border-neutral-content/10 pt-6 text-center text-xs text-neutral-content/40">
      <p>&copy; {year} Multitec Maldives Pvt. Ltd. All rights reserved.</p>
    </div>
  </div>
</footer>
