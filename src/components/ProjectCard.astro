---
import Dimension from './Dimension.astro';
import type { Project } from '../types';
import { sanityImageUrl } from '../utils/sanityImage';

interface Props {
  project: Project;
}

const { project } = Astro.props;
// Card renders at roughly 350-400px wide in the grid; 700px covers 2x retina
// without shipping the full-resolution Sanity original.
const coverImageUrl = project.coverImage ? sanityImageUrl(project.coverImage, 700) : undefined;
const categories = Array.isArray(project.category)
  ? project.category
  : project.category
    ? [project.category]
    : [];

function formatDate(dateStr: string): string {
  const [year, month] = dateStr.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[parseInt(month, 10) - 1]} ${year}`;
}

const meta = [project.location, project.completionDate && formatDate(project.completionDate)].filter(Boolean).join(' · ');
---

<!-- Editorial project card: photo with a measurement line on hover, then the
     title on a rule. The whole card is one link. -->
<article data-animate data-project-card data-categories={categories.join('|')}>
  <a href={`/projects/${project.slug}`} class="dimension-host group grid gap-4">
    <div class="relative pt-[26px]">
      <Dimension label={[project.location, categories[0]].filter(Boolean).join(' · ') || project.title} />
      <div class="relative aspect-[3/2] overflow-hidden bg-[#e4e7e9]">
        {coverImageUrl && (
          <img src={coverImageUrl} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
        )}
      </div>
    </div>
    <div class="grid gap-2 border-t border-[#d3d7da] pt-3.5">
      <h3 class="font-display text-xl font-bold leading-snug tracking-[-0.01em] text-[#1a1a1a] transition-colors group-hover:text-[#E31E24]">
        {project.title}
      </h3>
      {project.description && <p class="line-clamp-2 text-sm leading-relaxed">{project.description}</p>}
      {meta && <p class="text-sm text-[#5f6469]">{meta}</p>}
      {categories.length > 0 && (
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-[#5f6469]">{categories.join(' · ')}</p>
      )}
    </div>
  </a>
</article>
