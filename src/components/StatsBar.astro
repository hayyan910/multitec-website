---
import SectionHeading from './SectionHeading.astro';

interface Props {
  /** Optional section headline; without one the band is labelled for assistive tech only. */
  title?: string;
}

const { title } = Astro.props;

const stats = [
  { number: '23+', label: 'Years of experience', detail: 'In the Maldives since 2003' },
  { number: '100+', label: 'Panels supplied & installed', detail: 'Built and tested to IEC 61439' },
  { number: '200+', label: 'Projects completed', detail: 'From Malé towers to resorts' },
  { number: '50+', label: 'Clients served', detail: 'Developers, resorts, government' },
].map((stat) => {
  const [, value, suffix] = stat.number.match(/^(\d+)(.*)$/) ?? [null, stat.number, ''];
  return { ...stat, value, suffix };
});
---

<section class="bg-stone py-16 md:py-24" aria-labelledby={title ? 'stats-heading' : undefined} aria-label={title ? undefined : 'Company statistics'}>
  <div class="mx-auto max-w-6xl px-6">
    {title && <SectionHeading id="stats-heading" title={title} />}
    <dl class="grid grid-cols-2 gap-x-8 gap-y-10 lg:grid-cols-4" data-stats-bar>
      {stats.map((stat) => (
        <div class="stat relative flex flex-col pt-5">
          <dt class="order-2 mt-4 font-semibold text-[#1a1a1a]">
            {stat.label}
            <span class="mt-0.5 block text-sm font-normal text-[#5f6469]">{stat.detail}</span>
          </dt>
          <dd class="order-1 font-figures text-[clamp(3.2rem,6.4vw,6rem)] font-semibold leading-[0.9] tracking-[-0.035em] text-[#1a1a1a] tabular-nums">
            <span class="sr-only">{stat.number}</span>
            <span aria-hidden="true"><span class="stats-bar-value" data-target-value={stat.value}>{stat.value}</span><sup class="relative top-[0.12em] ml-[0.04em] align-top text-[0.42em] text-[#E31E24]">{stat.suffix}</sup></span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Rule above each figure; draws in left to right when the row is first seen. */
  .stat::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: #1a1a1a;
    transform-origin: left;
    transform: scaleX(var(--rule, 1));
  }
  :global([data-stats-armed]) .stat { --rule: 0; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initStatsBar() {
    const root = document.querySelector<HTMLElement>('[data-stats-bar]');
    if (!root) return;
    ScrollTrigger.getById('stats-bar')?.kill();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; // markup already shows final values

    const rules = Array.from(root.querySelectorAll<HTMLElement>('.stat'));
    const values = Array.from(root.querySelectorAll<HTMLElement>('.stats-bar-value'));
    root.dataset.statsArmed = '';

    // Built inside onEnter so nothing changes before the row is actually seen.
    ScrollTrigger.create({
      id: 'stats-bar',
      trigger: root,
      start: 'top 85%',
      once: true,
      onEnter: () => {
        values.forEach((valueEl) => { valueEl.textContent = '0'; });
        delete root.dataset.statsArmed;
        const tl = gsap.timeline();
        rules.forEach((rule, i) => {
          tl.fromTo(rule, { '--rule': 0 }, { '--rule': 1, duration: 0.9, ease: 'power2.inOut' }, i * 0.12);
        });
        values.forEach((valueEl, i) => {
          const counter = { val: 0 };
          tl.to(counter, {
            val: Number(valueEl.dataset.targetValue),
            duration: 1.4,
            ease: 'power2.out',
            onUpdate: () => { valueEl.textContent = String(Math.round(counter.val)); },
          }, i * 0.12);
        });
      },
    });
  }

  initStatsBar();
  document.addEventListener('astro:page-load', initStatsBar);
</script>
