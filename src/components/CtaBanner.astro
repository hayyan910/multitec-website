---
import SectionHeading from './SectionHeading.astro';

interface Props {
  heading: string;
  subtext: string;
  buttonText: string;
  buttonLink: string;
  /** Optional quieter second action, shown as a text link. */
  secondaryText?: string;
  secondaryLink?: string;
}

const { heading, subtext, buttonText, buttonLink, secondaryText, secondaryLink } = Astro.props;
---

<section class="bg-night py-20 md:py-28" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading id="cta-heading" title={heading} tone="dark" flush>
      <div slot="aside" class="grid max-w-md gap-6">
        <p class="text-base leading-relaxed">{subtext}</p>
        <div class="flex flex-wrap items-center gap-6">
          <a href={buttonLink} class="button-sweep on-dark">
            {buttonText}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg>
          </a>
          {secondaryText && secondaryLink && (
            <a href={secondaryLink} class="link-underline text-white">{secondaryText}</a>
          )}
        </div>
      </div>
    </SectionHeading>
  </div>
</section>
