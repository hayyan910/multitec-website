---
// Animated circuit board background: a bespoke (non-tiled) board drawing with
// real component symbols, flanking a centered text column on both sides.
// Sparks of current grow out of each chip and travel to the far end once on
// load, then follow scroll (forward and reverse) once the user scrolls.
//
// The dense detail (chips, components) stays in the left/right flanks —
// never under the centered text — so it works at any banner height via
// `preserveAspectRatio="xMidYMid slice"`. Used by PageHero.astro and 404.astro,
// which never have a competing photo, so this detail stays visible permanently.
---

<svg
  class="pointer-events-none absolute inset-0 h-full w-full"
  viewBox="0 0 1600 420"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <g id="cmp-resistor">
      <rect x="-9" y="-4" width="18" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
      <line x1="-14" y1="0" x2="-9" y2="0" stroke="currentColor" stroke-width="1.2" />
      <line x1="9" y1="0" x2="14" y2="0" stroke="currentColor" stroke-width="1.2" />
    </g>
    <g id="cmp-capacitor">
      <line x1="-14" y1="0" x2="-3" y2="0" stroke="currentColor" stroke-width="1.2" />
      <line x1="3" y1="0" x2="14" y2="0" stroke="currentColor" stroke-width="1.2" />
      <line x1="-3" y1="-7" x2="-3" y2="7" stroke="currentColor" stroke-width="1.4" />
      <line x1="3" y1="-7" x2="3" y2="7" stroke="currentColor" stroke-width="1.4" />
    </g>
    <g id="cmp-led">
      <line x1="-14" y1="0" x2="-6" y2="0" stroke="currentColor" stroke-width="1.2" />
      <line x1="6" y1="0" x2="14" y2="0" stroke="currentColor" stroke-width="1.2" />
      <path d="M-6,-6 L-6,6 L6,0 Z" fill="none" stroke="currentColor" stroke-width="1.2" />
      <line x1="6" y1="-6" x2="6" y2="6" stroke="currentColor" stroke-width="1.4" />
      <path d="M1,-8 L6,-13 M4,-13 L6,-13 L6,-11" fill="none" stroke="currentColor" stroke-width="1" />
      <path d="M5,-4 L10,-9 M8,-9 L10,-9 L10,-7" fill="none" stroke="currentColor" stroke-width="1" />
    </g>
    <g id="cmp-transistor">
      <circle cx="0" cy="0" r="10" fill="none" stroke="currentColor" stroke-width="1.2" />
      <line x1="-10" y1="0" x2="-3" y2="0" stroke="currentColor" stroke-width="1.2" />
      <line x1="-3" y1="-6" x2="-3" y2="6" stroke="currentColor" stroke-width="1.2" />
      <line x1="-3" y1="-4" x2="7" y2="-10" stroke="currentColor" stroke-width="1.1" />
      <line x1="-3" y1="4" x2="7" y2="10" stroke="currentColor" stroke-width="1.1" />
      <path d="M4,7 L7,10 L7,7 Z" fill="currentColor" stroke="none" />
    </g>
    <g id="cmp-ground">
      <line x1="0" y1="-3" x2="0" y2="3" stroke="currentColor" stroke-width="1.2" />
      <line x1="-7" y1="3" x2="7" y2="3" stroke="currentColor" stroke-width="1.2" />
      <line x1="-4.5" y1="6" x2="4.5" y2="6" stroke="currentColor" stroke-width="1.2" />
      <line x1="-2" y1="9" x2="2" y2="9" stroke="currentColor" stroke-width="1.2" />
    </g>
  </defs>

  <!-- dim base network: detail flanks the center (the text's keep-out column);
       thin flavor lines may still cross the center, matching the low-opacity
       crossing traces the site's original texture already used there -->
  <g>
    <path class="board-base-trace" d="M230,160 H340 V60 H420" />
    <path class="board-base-trace" d="M230,200 H320 V380 H400" />
    <path class="board-base-trace" d="M120,160 H40 V80" />
    <path class="board-base-trace" d="M120,210 H30 V320" />
    <path class="board-base-trace" d="M280,280 H180 V360" />
    <path class="board-base-trace" d="M360,280 H480 V220" />
    <path class="board-base-trace" d="M1370,160 H1260 V60 H1180" />
    <path class="board-base-trace" d="M1370,200 H1280 V380 H1200" />
    <path class="board-base-trace" d="M1480,160 H1560 V80" />
    <path class="board-base-trace" d="M1480,210 H1570 V320" />
    <path class="board-base-trace" d="M1320,280 H1420 V360" />
    <path class="board-base-trace" d="M1240,280 H1120 V220" />
    <path class="board-base-trace" d="M500,210 H1100" />
    <path class="board-base-trace" d="M560,340 H1040" />

    <rect class="board-chip" x="120" y="140" width="110" height="90" rx="6" />
    <rect class="board-chip" x="280" y="255" width="80" height="55" rx="5" />
    <rect class="board-chip" x="1370" y="140" width="110" height="90" rx="6" />
    <rect class="board-chip" x="1240" y="255" width="80" height="55" rx="5" />

    <rect class="board-pad" x="409" y="53" width="22" height="14" rx="2" />
    <rect class="board-pad" x="29" y="73" width="22" height="14" rx="2" />
    <rect class="board-pad" x="1149" y="53" width="22" height="14" rx="2" />
    <rect class="board-pad" x="1549" y="73" width="22" height="14" rx="2" />

    <circle class="board-via" cx="230" cy="160" r="2.6" />
    <circle class="board-via" cx="230" cy="200" r="2.6" />
    <circle class="board-via" cx="120" cy="160" r="2.6" />
    <circle class="board-via" cx="120" cy="210" r="2.6" />
    <circle class="board-via" cx="340" cy="60" r="2.6" />
    <circle class="board-via" cx="320" cy="380" r="2.6" />
    <circle class="board-via" cx="40" cy="80" r="2.6" />
    <circle class="board-via" cx="30" cy="320" r="2.6" />
    <circle class="board-via" cx="280" cy="280" r="2.6" />
    <circle class="board-via" cx="180" cy="360" r="2.6" />
    <circle class="board-via" cx="360" cy="280" r="2.6" />
    <circle class="board-via" cx="480" cy="220" r="2.6" />
    <circle class="board-via" cx="1370" cy="160" r="2.6" />
    <circle class="board-via" cx="1370" cy="200" r="2.6" />
    <circle class="board-via" cx="1480" cy="160" r="2.6" />
    <circle class="board-via" cx="1480" cy="210" r="2.6" />
    <circle class="board-via" cx="1260" cy="60" r="2.6" />
    <circle class="board-via" cx="1280" cy="380" r="2.6" />
    <circle class="board-via" cx="1560" cy="80" r="2.6" />
    <circle class="board-via" cx="1570" cy="320" r="2.6" />
    <circle class="board-via" cx="1320" cy="280" r="2.6" />
    <circle class="board-via" cx="1420" cy="360" r="2.6" />
    <circle class="board-via" cx="1240" cy="280" r="2.6" />
    <circle class="board-via" cx="1120" cy="220" r="2.6" />

    <use href="#cmp-resistor" class="board-component" transform="translate(285,60)" />
    <use href="#cmp-capacitor" class="board-component" transform="translate(120,185) rotate(90)" />
    <use href="#cmp-led" class="board-component" transform="translate(180,320)" />
    <use href="#cmp-transistor" class="board-component" transform="translate(420,250)" />
    <use href="#cmp-resistor" class="board-component" transform="translate(1315,60)" />
    <use href="#cmp-capacitor" class="board-component" transform="translate(1370,185) rotate(90)" />
    <use href="#cmp-led" class="board-component" transform="translate(1420,320)" />
    <use href="#cmp-transistor" class="board-component" transform="translate(1180,250)" />
  </g>

  <!-- glow network: current fans out from both side chips. stroke-dasharray is
       set as an attribute (not just in CSS) so it's invisible from the very
       first parsed byte of HTML, with no dependency on a stylesheet having
       loaded yet — the CSS rule alone left a gap on a hard refresh (cold
       cache), where the stylesheet can arrive after the first paint and the
       path briefly renders as a full solid line with no dasharray at all. -->
  <g>
    <path class="glow-trace" stroke-dasharray="0 99999" d="M230,160 H340 V60 H420" />
    <path class="glow-trace" stroke-dasharray="0 99999" d="M120,210 H30 V320" />
    <path class="glow-trace" stroke-dasharray="0 99999" d="M360,280 H480 V220" />
    <path class="glow-trace" stroke-dasharray="0 99999" d="M1370,160 H1260 V60 H1180" />
    <path class="glow-trace" stroke-dasharray="0 99999" d="M1480,210 H1570 V320" />
    <path class="glow-trace" stroke-dasharray="0 99999" d="M1240,280 H1120 V220" />
  </g>
</svg>

<style>
  .board-base-trace {
    stroke: rgba(255, 255, 255, 0.09);
    stroke-width: 1.3;
    fill: none;
  }
  .board-via {
    fill: rgba(255, 255, 255, 0.16);
  }
  .board-pad {
    fill: none;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1.2;
  }
  .board-chip {
    fill: rgba(255, 255, 255, 0.03);
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.2;
  }
  .glow-trace {
    stroke: #ff6b6f;
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
    filter: drop-shadow(0 0 3px rgba(255, 90, 95, 0.9)) drop-shadow(0 0 9px rgba(227, 30, 36, 0.55));
    /* Static fallback so the path never paints as a full solid line before the
       script sets its real per-path dasharray — without this, every trace
       flashes fully drawn for a frame on each hard reload (no dasharray yet
       means a continuous stroke along the whole path). */
    stroke-dasharray: 0 99999;
  }
  .board-component {
    color: rgba(255, 255, 255, 0.17);
  }
</style>

<script>
  // A short dash travels out from its chip, like a spark of current — growing
  // out of the chip rather than appearing already full-size: near the chip
  // (progress under GROW_PORTION) the visible length ramps from nothing up to
  // full, pinned at the chip; past that it's a constant-length dash
  // translating forward until it exits at the far end.
  //
  // On load: a single one-way trip out, time-driven. Once it finishes,
  // scrolling takes over — the displayed position eases toward a
  // scroll-driven target every frame (rather than jumping straight to a value
  // derived from raw scroll input), so motion always passes back through the
  // same grow phase instead of snapping.
  //
  // Re-initializes on every View Transition navigation (astro:page-load) —
  // this component appears on multiple pages, and the page is swapped without
  // a full reload, so the previous page's rAF loop and scroll listener must be
  // torn down before a fresh one starts, or they'd stack up on every visit.
  let rafId: number | null = null;
  let scrollHandler: (() => void) | null = null;

  function initCircuitBoard() {
    if (rafId !== null) cancelAnimationFrame(rafId);
    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    rafId = null;
    scrollHandler = null;

    const glowPaths = Array.from(document.querySelectorAll<SVGPathElement>('.glow-trace'));
    if (!glowPaths.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SCROLL_DISTANCE_FOR_FULL_TRAVEL = 600; // px of scroll for target 0 -> 1
    const GROW_PORTION = 0.18; // fraction of the trip spent emerging at the chip
    const SMOOTHING = 0.14; // per-frame ease-toward-target rate once scrolling

    function easeInOutCubic(t: number): number {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    const entries = glowPaths.map((path, i) => {
      const len = path.getTotalLength();
      const dashLen = Math.max(40, len * 0.28);
      path.style.strokeDashoffset = '0';
      return {
        path,
        len,
        dashLen,
        progress: 0, // displayed (smoothed) progress
        targetProgress: 0, // scroll-driven target, post-intro
        distanceScale: 1 + i * 0.05, // mild per-path variation, avoids lockstep
        introDelay: 400 + i * 90,
        introDuration: 1100 + len * 1.8,
        introFinished: false,
      };
    });

    // Renders one path at progress p: 0 = nothing, pinned at the chip;
    // GROW_PORTION = fully grown, still at the chip; 1 = fully exited.
    function applyProgress(entry: (typeof entries)[number], p: number) {
      p = Math.min(1, Math.max(0, p));
      let visibleLen: number;
      let off: number;
      if (p <= GROW_PORTION) {
        visibleLen = entry.dashLen * (p / GROW_PORTION);
        off = 0;
      } else {
        visibleLen = entry.dashLen;
        const p2 = (p - GROW_PORTION) / (1 - GROW_PORTION);
        off = -(p2 * entry.len);
      }
      entry.path.style.strokeDasharray = `${Math.max(0.6, visibleLen)} ${entry.len * 2}`;
      entry.path.style.strokeDashoffset = String(off);
    }

    let introStartTime: number | null = null;
    let introDone = false;
    let lastScrollY: number | null = null;

    function onScroll() {
      if (!introDone) return; // one-way intro is non-interruptible by design
      if (lastScrollY === null) {
        lastScrollY = window.scrollY; // establish baseline, no jump
        return;
      }
      const deltaY = window.scrollY - lastScrollY;
      lastScrollY = window.scrollY;
      entries.forEach((entry) => {
        const step = deltaY / (SCROLL_DISTANCE_FOR_FULL_TRAVEL * entry.distanceScale);
        entry.targetProgress = Math.min(1, Math.max(0, entry.targetProgress + step));
      });
    }

    function tick(now: number) {
      if (introStartTime === null) introStartTime = now;
      let anyIntroRunning = false;

      entries.forEach((entry) => {
        if (!introDone && !entry.introFinished) {
          if (prefersReducedMotion) {
            entry.introFinished = true;
            applyProgress(entry, 0);
            return;
          }
          const elapsed = now - introStartTime! - entry.introDelay;
          if (elapsed < 0) {
            anyIntroRunning = true;
            applyProgress(entry, 0);
            return;
          }
          const t = Math.min(1, elapsed / entry.introDuration);
          applyProgress(entry, easeInOutCubic(t));
          if (t < 1) {
            anyIntroRunning = true;
          } else {
            entry.introFinished = true;
            applyProgress(entry, 0); // already exited/invisible at p=1 — resetting here is unseen
          }
        } else if (introDone) {
          entry.progress += (entry.targetProgress - entry.progress) * SMOOTHING;
          if (Math.abs(entry.targetProgress - entry.progress) < 0.001) {
            entry.progress = entry.targetProgress;
          }
          applyProgress(entry, entry.progress);
        }
      });

      if (!introDone && !anyIntroRunning) introDone = true;
      rafId = requestAnimationFrame(tick);
    }

    scrollHandler = onScroll;
    window.addEventListener('scroll', scrollHandler, { passive: true });
    rafId = requestAnimationFrame(tick);
  }

  initCircuitBoard();
  document.addEventListener('astro:page-load', initCircuitBoard);
</script>
