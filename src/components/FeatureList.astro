---
interface Props {
  items: { title: string; description: string }[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<!-- Points set as type on rules rather than as icon cards. -->
<ul class:list={['grid gap-x-10 gap-y-12', columns === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
  {items.map((item) => (
    <li class="border-t-[1.5px] border-[#1a1a1a] pt-6" data-animate>
      <h3 class="font-display text-[clamp(1.35rem,2.2vw,1.75rem)] font-bold leading-tight tracking-[-0.015em] text-[#1a1a1a]">{item.title}</h3>
      <p class="mt-3 max-w-md leading-relaxed">{item.description}</p>
    </li>
  ))}
</ul>
