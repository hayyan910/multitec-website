---
const { pathname } = Astro.url;

const navLinks = [
  { href: '/',         label: 'Home' },
  { href: '/about',    label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact',  label: 'Contact' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#1a1a1a]" role="banner">
  <div class="container mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo -->
    <a href="/" aria-label="Multitec Maldives — go to homepage" class="flex-shrink-0">
      <img
        src="/images/company/multitec_logo_white.svg"
        alt="Multitec Maldives"
        width="160"
        height="48"
        class="h-12 w-auto"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      <ul class="flex items-center gap-8 list-none" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={[
                'text-sm font-medium transition-colors duration-200',
                'underline-offset-4 decoration-2 decoration-[#E31E24]',
                pathname === href
                  ? 'text-[#E31E24] underline'
                  : 'text-white/70 hover:text-white hover:underline',
              ].join(' ')}
              aria-current={pathname === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <a href="/contact" class="btn btn-primary btn-sm ml-2 shrink-0">
        Get in Touch
      </a>
    </nav>

    <!-- Mobile hamburger — toggles the DaisyUI drawer defined in BaseLayout -->
    <label
      for="mobile-nav-drawer"
      class="btn btn-ghost btn-sm text-white md:hidden"
      aria-label="Open navigation menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>
</header>
