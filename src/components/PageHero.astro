---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  breadcrumb: BreadcrumbItem[];
}

const { title, subtitle, breadcrumb } = Astro.props;
---

<section class="relative flex min-h-[40vh] items-center overflow-hidden bg-[#1a1a1a]">
  <!-- Subtle red gradient accent top-right -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(227,30,36,0.18)_0%,transparent_65%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-6 py-16 text-center">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex list-none items-center justify-center gap-2 text-sm">
        {breadcrumb.map((item, i) => (
          <li class="flex items-center gap-2">
            {item.href ? (
              <a href={item.href} class="text-white/50 transition-colors hover:text-white/80">
                {item.label}
              </a>
            ) : (
              <span class="text-white/80" aria-current="page">{item.label}</span>
            )}
            {i < breadcrumb.length - 1 && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3 w-3 shrink-0 text-white/30"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="text-3xl font-bold tracking-tight text-white md:text-4xl lg:text-5xl">
      {title}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-white/65 md:text-lg">
      {subtitle}
    </p>
  </div>
</section>
