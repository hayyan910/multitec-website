---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  breadcrumb: BreadcrumbItem[];
}

const { title, subtitle, breadcrumb } = Astro.props;
---

<!-- Inner-page banner: deep ink, left-aligned, one large headline. -->
<section class="surface-ink text-white">
  <div class="column pb-16 pt-12 md:pb-24 md:pt-16">
    <nav aria-label="Breadcrumb">
      <ol class="flex list-none flex-wrap items-center gap-2 text-sm">
        {breadcrumb.map((item, i) => (
          <li class="flex items-center gap-2">
            {item.href ? (
              <a href={item.href} class="text-white/60 transition-colors hover:text-white">{item.label}</a>
            ) : (
              <span class="text-white/85" aria-current="page">{item.label}</span>
            )}
            {i < breadcrumb.length - 1 && <span class="text-white/35" aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </nav>

    <span class="mb-6 mt-10 block h-1 w-16 bg-[#E31E24] md:mt-14" aria-hidden="true"></span>
    <h1 class="max-w-4xl font-headline text-[clamp(2.6rem,6vw,5rem)] font-extrabold leading-[0.96] tracking-[-0.03em] [text-wrap:balance]">
      {title}
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/70">{subtitle}</p>
    <slot />
  </div>
</section>
