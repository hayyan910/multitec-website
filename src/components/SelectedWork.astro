---
import Dimension from './Dimension.astro';
import { sanityImageUrl } from '../utils/sanityImage';
import type { Project } from '../types';

interface Props {
  /** First project is shown large; the next two sit beside it. */
  projects: Project[];
}

const { projects } = Astro.props;
const items = projects.slice(0, 3).map((project, i) => ({
  project,
  feature: i === 0,
  image: project.coverImage ? sanityImageUrl(project.coverImage, i === 0 ? 1200 : 800, 80) : undefined,
  scope: (project.category ?? []).join(' · '),
}));
---

<!-- Dark project grid. On hover (or, on touch screens, when a card is in the
     middle of the screen) a drawing-style measurement line labels the photo
     with the project's location and scope. -->
<div class="grid gap-x-8 gap-y-12 lg:grid-cols-12 lg:gap-y-8">
  {items.map(({ project, feature, image, scope }, i) => (
    <a
      href={`/projects/${project.slug}`}
      class:list={['dimension-host group grid grid-rows-[1fr_auto] gap-4', feature ? 'lg:col-span-7 lg:row-span-2' : 'lg:col-span-5']}
    >
      <div class="relative flex flex-1 flex-col pt-[26px]">
        <Dimension label={[project.location, scope].filter(Boolean).join(' · ')} tone="dark" />
        <div
          class:list={['work-shot relative overflow-hidden bg-ink-2', feature ? 'aspect-[3/2] lg:aspect-auto lg:min-h-[22rem] lg:flex-1' : 'aspect-[3/2] lg:aspect-auto lg:min-h-[13rem] lg:flex-1']}
          data-animate="wipe"
          style={`--wipe-delay:${i * 0.12}s`}
        >
          {image && (
            <img src={image} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
          )}
        </div>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-t border-white/12 pt-3.5">
        <h3 class="font-display text-[clamp(1.25rem,2vw,1.65rem)] font-bold tracking-[-0.015em] text-white transition-colors group-hover:text-signal">
          {project.title}
        </h3>
        {project.location && <span class="whitespace-nowrap text-sm text-white/60">{project.location}</span>}
      </div>
    </a>
  ))}
</div>

