---
import { sanityImageUrl } from '../utils/sanityImage';
import type { Project } from '../types';

interface Props {
  /** First project is shown large; the next two sit beside it. */
  projects: Project[];
}

const { projects } = Astro.props;
const items = projects.slice(0, 3).map((project, i) => ({
  project,
  feature: i === 0,
  image: project.coverImage ? sanityImageUrl(project.coverImage, i === 0 ? 1200 : 800, 80) : undefined,
  scope: (project.category ?? []).join(' · '),
}));
---

<!-- Dark project grid. On hover (or, on touch screens, when a card is in the
     middle of the screen) a drawing-style measurement line labels the photo
     with the project's location and scope. -->
<div class="grid gap-x-8 gap-y-12 lg:grid-cols-12 lg:gap-y-8" data-selected-work>
  {items.map(({ project, feature, image, scope }, i) => (
    <a
      href={`/projects/${project.slug}`}
      class:list={['work-card group grid grid-rows-[1fr_auto] gap-4', feature ? 'lg:col-span-7 lg:row-span-2' : 'lg:col-span-5']}
    >
      <div class="relative flex flex-1 flex-col pt-[26px]">
        <span class="dimension" aria-hidden="true">
          <span class="dimension-line"></span>
          <span class="dimension-tick dimension-tick--start"></span>
          <span class="dimension-tick dimension-tick--end"></span>
          <span class="dimension-label">{[project.location, scope].filter(Boolean).join(' · ')}</span>
        </span>
        <div
          class:list={['work-shot relative overflow-hidden bg-night-2', feature ? 'aspect-[3/2] lg:aspect-auto lg:min-h-[22rem] lg:flex-1' : 'aspect-[3/2] lg:aspect-auto lg:min-h-[13rem] lg:flex-1']}
          data-animate="wipe"
          style={`--wipe-delay:${i * 0.12}s`}
        >
          {image && (
            <img src={image} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
          )}
        </div>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-t border-white/12 pt-3.5">
        <h3 class="font-display text-[clamp(1.25rem,2vw,1.65rem)] font-bold tracking-[-0.015em] text-white transition-colors group-hover:text-[#ff3a40]">
          {project.title}
        </h3>
        {project.location && <span class="whitespace-nowrap text-sm text-white/60">{project.location}</span>}
      </div>
    </a>
  ))}
</div>

<style>
  .dimension { position: absolute; left: 0; right: 0; top: 6px; height: 14px; pointer-events: none; }
  .dimension-line { position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: #ff3a40; transform: scaleX(0); }
  .dimension-tick { position: absolute; top: 1px; width: 1px; height: 12px; background: #ff3a40; rotate: 45deg; opacity: 0; }
  .dimension-tick--start { left: 0; }
  .dimension-tick--end { right: 0; }
  .dimension-label {
    position: absolute;
    left: 50%;
    top: 7px;
    translate: -50% -50%;
    padding: 0 0.5rem;
    background: var(--color-night);
    color: #ff3a40;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  .work-card:hover .dimension-line,
  .work-card:focus-visible .dimension-line,
  .work-card.is-near .dimension-line { transform: none; }
  .work-card:hover :is(.dimension-tick, .dimension-label),
  .work-card:focus-visible :is(.dimension-tick, .dimension-label),
  .work-card.is-near :is(.dimension-tick, .dimension-label) { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .dimension-line { transition: transform 0.55s cubic-bezier(0.65, 0, 0.35, 1); }
    .dimension-tick { transition: opacity 0.2s 0.4s; }
    .dimension-label { transition: opacity 0.3s 0.45s; }
  }
</style>

<script>
  // Touch screens have no hover: show the line on the card nearest the
  // middle of the screen instead.
  function initSelectedWork() {
    const root = document.querySelector<HTMLElement>('[data-selected-work]');
    if (!root || root.dataset.bound || matchMedia('(hover: hover)').matches || !('IntersectionObserver' in window)) return;
    root.dataset.bound = 'true';
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-near', e.isIntersecting)),
      { rootMargin: '-35% 0px -35% 0px' },
    );
    root.querySelectorAll('.work-card').forEach((card) => io.observe(card));
  }

  initSelectedWork();
  document.addEventListener('astro:page-load', initSelectedWork);
</script>
